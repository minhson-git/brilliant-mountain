<?xml version="1.0" encoding="utf-8" ?>
<apps:MainWindowPage
    x:Class="IOApp.Pages.JunkFiles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:apps="using:IOApp"
    xmlns:coreHelpers="using:IOCore.Helpers"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:IOApp.Pages"
    d:DataContext="{d:DesignInstance Type=pages:JunkFiles}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <apps:MainWindowPage.Resources>
        <pages:JunkFilesProxy x:Name="Proxy" Data="{Binding}" />
    </apps:MainWindowPage.Resources>

    <Grid>
        <coreUI:AZ IsA="{Binding JunkFileGroupItems.IsEmpty}">
            <coreUI:AZ.A>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="120"
                        Glyph="&#xEA99;" />
                    <TextBlock HorizontalAlignment="Center" FontSize="20" />
                    <TextBlock Text="{coreHelpers:SRE K=TitleScanJunkFile}" />
                    <coreUI:IconTextButton
                        Width="200"
                        Command="{Binding ScanAllCommand}"
                        Icon="&#xEA99;"
                        IsTheme="True"
                        Text="Scan"
                        Visibility="{Binding Status.IsNotLoading}" />
                </StackPanel>
            </coreUI:AZ.A>
            <coreUI:AZ.B>
                <Grid
                    Padding="10"
                    RowDefinitions="Auto,*,Auto"
                    RowSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <coreUI:ABIconButton
                            VerticalAlignment="Center"
                            BIcon="&#xe739;"
                            Command="{Binding Data.SelectFilesCommand, Source={StaticResource Proxy}}"
                            Icon="&#xe73d;"
                            IsAOrB="{Binding IsChecked}"
                            IsEnabled="{Binding Status.IsNotProcessing}"
                            Size="LG"
                            Variant="Text" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold">
                            <Run Text="Total space to free up" />
                            <Run Text="{Binding TotalSize, Converter={StaticResource FileSizeToStringConverter}}" />
                        </TextBlock>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{Binding JunkFileGroupItems}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="5" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="10"
                                        Background="{ThemeResource WindowBackground}"
                                        ColumnDefinitions="Auto,Auto,*,Auto"
                                        ColumnSpacing="20"
                                        CornerRadius="5">
                                        <coreUI:ABIconButton
                                            VerticalAlignment="Center"
                                            BIcon="&#xe739;"
                                            Command="{Binding Data.SelectItemCommand, Source={StaticResource Proxy}}"
                                            CommandParameter="{Binding}"
                                            Icon="&#xe73d;"
                                            IsAOrB="{Binding IsSelected}"
                                            IsEnabled="{Binding Data.Status.IsNotProcessing, Source={StaticResource Proxy}}"
                                            Variant="Text" />
                                        <FontIcon
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Glyph="{Binding Icon}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="{Binding Name}" />

                                        <coreUI:AZ Grid.Column="3" IsA="{Binding Status.IsProcessInQueue}">
                                            <coreUI:AZ.A>
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                    <ProgressRing
                                                        Width="20"
                                                        Height="20"
                                                        Background="{ThemeResource ProgressRingForeground}"
                                                        IsActive="True" />
                                                    <coreUI:IconButton
                                                        Grid.Column="1"
                                                        Command="{Binding Data.CancelItemCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding}"
                                                        Icon="&#xE711;" />
                                                </Grid>
                                            </coreUI:AZ.A>
                                            <coreUI:AZ.B>
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                                                    <Border
                                                        Width="100"
                                                        BorderBrush="SkyBlue"
                                                        BorderThickness="1"
                                                        CornerRadius="5">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="SkyBlue"
                                                            Text="{Binding TotalSize, Converter={StaticResource FileSizeToStringConverter}}" />
                                                    </Border>
                                                </Grid>
                                            </coreUI:AZ.B>
                                        </coreUI:AZ>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <Grid
                        Grid.Row="2"
                        Padding="10"
                        Background="{ThemeResource WindowBackground}"
                        ColumnDefinitions="*,Auto"
                        CornerRadius="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold">
                            <Run Text="{Binding JunkFileSize, Converter={StaticResource FileSizeToStringConverter}}" />
                            <Run Text="selected space to free up" />
                        </TextBlock>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="10">
                            <coreUI:IconTextButton
                                Command="{Binding ScanAllCommand}"
                                Icon="&#xE72C;"
                                IsEnabled="{Binding Status.IsNotProcessing}"
                                Text="Scan" />
                            <coreUI:IconTextButton
                                Command="{Binding CleanAllCommand}"
                                Icon="&#xEA99;"
                                IsEnabled="{Binding Status.IsNotProcessing}"
                                IsTheme="True"
                                Text="Clean" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </coreUI:AZ.B>
        </coreUI:AZ>
    </Grid>
</apps:MainWindowPage>
<?xml version="1.0" encoding="utf-8" ?>
<app:MainWindowPage
    x:Class="IOApp.Pages.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:IOApp"
    xmlns:c="using:IOCore"
    xmlns:cb="using:IOCore.Base"
    xmlns:cl="using:IOCore.License"
    xmlns:cme="using:IOCore.MarkupExtensions"
    xmlns:coreAppManager="using:IOCore.AppManager"
    xmlns:cui="using:IOCore.UI"
    xmlns:cuib="using:IOCore.UI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:IOApp.Pages"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <app:MainWindowPage.Resources>
        <pages:HomeProxy x:Name="Proxy" _="{x:Bind}" />
    </app:MainWindowPage.Resources>

    <Grid
        Padding="10"
        ColumnDefinitions="*,360"
        ColumnSpacing="10">
        <Grid RowDefinitions="*,120,120" RowSpacing="5">
            <Grid
                Padding="5"
                Background="{ThemeResource WindowBackground}"
                CornerRadius="10"
                Loaded="DragDropVideoGrid_Loaded">
                <cui:AZ IsA="{x:Bind PlayerVideo.Playlist.IsEmpty}">
                    <cui:AZ.A>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <cui:IconButton Icon="&#xE714;" Size="XXXL" />
                            <!--
                                Command="{x:Bind AddFileCommand}"
                                CommandParameter="Video"
                            -->
                            <StackPanel Spacing="5">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{cme:SR K=AddVideo}" />

                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{cme:SR K=OrDragAndDrop}" />
                            </StackPanel>
                        </StackPanel>
                    </cui:AZ.A>
                    <cui:AZ.B>
                        <Grid>
                            <ContentPresenter Loaded="PresenterVideo_Loaded" />

                            <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                                <cui:IconButton
                                    Icon="&#xEDAB;"
                                    IsEnabled="{x:Bind Status.IsNotLoading}"
                                    Variant="Text" />
                                <!--
                                    Command="{x:Bind AddFileCommand}"
                                    CommandParameter="Video"
                                -->
                                <Border
                                    Height="24"
                                    Padding="10,0"
                                    Background="#55000000"
                                    CornerRadius="10">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#fff"
                                        Text="{x:Bind PlayerVideo.Current.InputInfo.Name}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </cui:AZ.B>
                </cui:AZ>
            </Grid>

            <Grid
                Grid.Row="1"
                Padding="5"
                Background="{ThemeResource WindowBackground}"
                CornerRadius="10"
                Loaded="DragDropAudioGrid_Loaded">
                <cui:AZ IsA="{x:Bind PlayerAudio.Playlist.IsEmpty}">
                    <cui:AZ.A>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <cui:IconButton Icon="&#xE8D6;" Size="XXXL" />
                            <!--
                                Command="{x:Bind AddFileCommand}"
                                CommandParameter="Audio"
                            -->
                            <StackPanel Spacing="5">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{cme:SR K=AddAudio}" />

                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{cme:SR K=OrDragAndDrop}" />
                            </StackPanel>
                        </StackPanel>
                    </cui:AZ.A>
                    <cui:AZ.B>
                        <Grid>
                            <FontIcon FontSize="64" Glyph="&#xEC4F;" />

                            <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                                <cui:IconButton
                                    Icon="&#xEDAB;"
                                    IsEnabled="{x:Bind Status.IsNotLoading}"
                                    Variant="Text" />
                                <!--
                                    Command="{x:Bind AddFileCommand}"
                                    CommandParameter="Audio"
                                -->
                                <Border
                                    Height="24"
                                    Padding="10,0"
                                    Background="#55000000"
                                    CornerRadius="10">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#fff"
                                        Text="{x:Bind PlayerAudio.Current.InputInfo.Name}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </cui:AZ.B>
                </cui:AZ>
            </Grid>

            <Grid
                Grid.Row="2"
                Padding="5"
                Background="{ThemeResource WindowBackground}"
                CornerRadius="10">
                <Grid VerticalAlignment="Top" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <cui:IconTextButton
                            Command="{x:Bind OpenDownloadDialogCommand}"
                            CommandParameter="Video"
                            IsThemeEnabled="True"
                            Scheme="Theme"
                            Text="{cme:SR K=VideoDownloader}" />

                        <cui:IconTextButton
                            Command="{x:Bind OpenDownloadDialogCommand}"
                            CommandParameter="Audio"
                            IsThemeEnabled="True"
                            Scheme="Theme"
                            Text="{cme:SR K=AudioDownloader}" />
                    </StackPanel>

                    <coreAppManager:PromotionApp
                        Grid.Column="2"
                        cuib:Enable.Value1="{x:Bind cl:IOLicense.I.Status.IsTrial, Mode=OneWay}"
                        cuib:Enable.Value2="{x:Bind cuib:Menu.PromotionAppItems.IsNotEmpty, Mode=OneWay}"
                        DataContext="{x:Bind cuib:Menu.PromotionAppItems.FirstItem}"
                        IsLite="True" />
                </Grid>

                <StackPanel VerticalAlignment="Bottom">
                    <Grid Padding="10,0" ColumnDefinitions="70,*,70">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#fff"
                            Text="{x:Bind PlayerVideo.Player.CurTime, Mode=OneWay, Converter={StaticResource TicksToStringConverter}}" />
                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind PlayerVideo.Player.CanPlay, Mode=OneWay}"
                            IsThumbToolTipEnabled="False"
                            Loaded="TimeSlider_Loaded"
                            Maximum="{x:Bind PlayerVideo.Player.Duration, Mode=OneWay, Converter={StaticResource SecondsFromTicksConverter}}"
                            Value="{x:Bind PlayerVideo.Player.CurTime, Mode=TwoWay, Converter={StaticResource SecondsFromTicksConverter}}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="#fff"
                            HorizontalTextAlignment="Right"
                            Text="{x:Bind PlayerVideo.Player.Duration, Mode=OneWay, Converter={StaticResource TicksToStringConverter}}" />
                    </Grid>

                    <Grid>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <cui:ABIconButton
                                CheckedIcon="&#xE769;"
                                Command="{x:Bind PlayCommand}"
                                Icon="&#xE768;"
                                IsChecked="{x:Bind PlayerVideo.Player.Status, Mode=OneWay, ConverterParameter=Playing, Converter={StaticResource EnumComparisonToBoolConverter}}"
                                IsEnabled="{x:Bind PlayerVideo.Player.CanPlay, Mode=OneWay}"
                                Variant="Text" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid
            Grid.Column="1"
            RowDefinitions="*,120,120"
            RowSpacing="5">
            <Grid
                Padding="10"
                Background="{ThemeResource WindowBackground}"
                BorderBrush="{ThemeResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                RowDefinitions="Auto,*"
                RowSpacing="5">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{cme:SR K=VideoEdit}" />

                <StackPanel Grid.Row="1" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{cme:SR K=Speed}" />

                        <Slider
                            Grid.Column="1"
                            Margin="20,0,10,0"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind VideoItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}"
                            Maximum="4"
                            Minimum="0.25"
                            SnapsTo="StepValues"
                            StepFrequency="0.05"
                            TickFrequency="0.5"
                            TickPlacement="Outside"
                            Value="{x:Bind VideoSpeedValue, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{cme:SR K=Volume}" />

                        <Slider
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind VideoItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}"
                            Maximum="{x:Bind PlayerVideo.Player.Config.Audio.VolumeMax, Mode=OneWay}"
                            Minimum="0"
                            Value="{x:Bind PlayerVideo.Player.Audio.Volume, Mode=TwoWay}" />

                        <cui:IconButton
                            Grid.Column="2"
                            Command="{x:Bind MuteCommand}"
                            CommandParameter="Video"
                            Icon="{x:Bind PlayerVideo.VolumeIcon, Mode=OneWay}"
                            IsEnabled="{x:Bind VideoItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}"
                            Variant="Text" />


                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{cme:SR K=Quality}" />

                        <cui:ComboBoxEx
                            Grid.Column="2"
                            Width="200"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Value"
                            IsEnabled="{x:Bind Status.IsNotProcessing}"
                            ItemsSource="{x:Bind VideoItem.ConvertArgs.ResolutionSelection.Items}"
                            SelectedIndex="{x:Bind VideoItem.ConvertArgs.ResolutionSelection.SelectedIndex, Mode=TwoWay}">
                            <cui:ComboBoxEx.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="cb:Bind.IsEnabled" Value="IsEnabled" />
                                </Style>
                            </cui:ComboBoxEx.ItemContainerStyle>
                        </cui:ComboBoxEx>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{cme:SR K=Format}" />

                        <cui:ComboBoxEx
                            Grid.Column="2"
                            Width="200"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Value"
                            IsEnabled="{x:Bind Status.IsNotProcessing}"
                            ItemsSource="{x:Bind VideoItem.ConvertArgs.FamilySelection.Items}"
                            SelectedIndex="{x:Bind VideoItem.ConvertArgs.FamilySelection.SelectedIndex, Mode=TwoWay}">
                            <cui:ComboBoxEx.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="cb:Bind.IsEnabled" Value="IsEnabled" />
                                </Style>
                            </cui:ComboBoxEx.ItemContainerStyle>
                        </cui:ComboBoxEx>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{cme:SR K=Rotate}" />

                                <cui:IconButton
                                    Command="{x:Bind ApplyTransformCommand}"
                                    CommandParameter="ClockwiseRotation"
                                    Icon="&#xE7AD;"
                                    IsEnabled="{x:Bind VideoItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{cme:SR K=Flip}" />

                                <StackPanel Orientation="Horizontal">
                                    <cui:IconButton
                                        Command="{x:Bind ApplyTransformCommand}"
                                        CommandParameter="HorizontalFlip"
                                        Icon="&#xF583;"
                                        IsEnabled="{x:Bind VideoItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}" />

                                    <cui:IconButton
                                        Command="{x:Bind ApplyTransformCommand}"
                                        CommandParameter="VerticalFlip"
                                        Icon="&#xF589;"
                                        IsEnabled="{x:Bind VideoItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <cui:IconButton
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Icon="&#xE713;"
                            IsEnabled="{x:Bind VideoItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}">

                            <cui:IconButton.Flyout>
                                <Flyout>
                                    <StackPanel Width="240" Spacing="10">
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{cme:SR K=Video}" />
                                            <VariableSizedWrapGrid
                                                ItemWidth="120"
                                                MaximumRowsOrColumns="2"
                                                Orientation="Horizontal">
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{cme:SR K=Media_FrameRate}" />
                                                    <cui:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{x:Bind VideoItem.ConvertArgs.FrameRateSelection.Items}"
                                                        SelectedIndex="{x:Bind VideoItem.ConvertArgs.FrameRateSelection.SelectedIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{cme:SR K=Media_VideoCodec}" />
                                                    <cui:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{x:Bind VideoItem.ConvertArgs.VideoCodecSelection.Items}"
                                                        SelectedIndex="{x:Bind VideoItem.ConvertArgs.VideoCodecSelection.SelectedIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{cme:SR K=Media_VideoBitrate}" />
                                                    <cui:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{x:Bind VideoItem.ConvertArgs.VideoBitrateSelection.Items}"
                                                        SelectedIndex="{x:Bind VideoItem.ConvertArgs.VideoBitrateSelection.SelectedIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                            </VariableSizedWrapGrid>
                                        </StackPanel>
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{cme:SR K=Audio}" />
                                            <VariableSizedWrapGrid
                                                ItemWidth="120"
                                                MaximumRowsOrColumns="2"
                                                Orientation="Horizontal">
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{cme:SR K=Media_AudioCodec}" />
                                                    <cui:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{x:Bind VideoItem.ConvertArgs.AudioCodecSelection.Items}"
                                                        SelectedIndex="{x:Bind VideoItem.ConvertArgs.AudioCodecSelection.SelectedIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{cme:SR K=Media_AudioChannel}" />
                                                    <cui:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{x:Bind VideoItem.ConvertArgs.ChannelSelection.Items}"
                                                        SelectedIndex="{x:Bind VideoItem.ConvertArgs.ChannelSelection.SelectedIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{cme:SR K=Media_SampleRate}" />
                                                    <cui:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{x:Bind VideoItem.ConvertArgs.SampleRateSelection.Items}"
                                                        SelectedIndex="{x:Bind VideoItem.ConvertArgs.SampleRateSelection.SelectedIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{cme:SR K=Media_AudioBitrate}" />
                                                    <cui:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{x:Bind VideoItem.ConvertArgs.AudioBitrateSelection.Items}"
                                                        SelectedIndex="{x:Bind VideoItem.ConvertArgs.AudioBitrateSelection.SelectedIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                            </VariableSizedWrapGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </cui:IconButton.Flyout>
                        </cui:IconButton>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                Padding="10"
                Background="{ThemeResource WindowBackground}"
                BorderBrush="{ThemeResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                RowDefinitions="Auto,*"
                RowSpacing="5">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{cme:SR K=AudioEdit}" />

                <StackPanel Grid.Row="1" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{cme:SR K=Speed}" />

                        <Slider
                            Grid.Column="1"
                            Margin="20,0,10,0"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind AudioItem, Converter={StaticResource InvertedIsNull}}"
                            Maximum="4"
                            Minimum="0.25"
                            SnapsTo="StepValues"
                            StepFrequency="0.05"
                            TickFrequency="0.5"
                            TickPlacement="Outside"
                            Value="{x:Bind AudioSpeedValue, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{cme:SR K=Volume}" />

                        <Slider
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind AudioItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}"
                            Maximum="{x:Bind PlayerAudio.Player.Config.Audio.VolumeMax, Mode=OneWay}"
                            Minimum="0"
                            Value="{x:Bind PlayerAudio.Player.Audio.Volume, Mode=TwoWay}" />

                        <cui:IconButton
                            Grid.Column="2"
                            Command="{x:Bind MuteCommand}"
                            CommandParameter="Audio"
                            Icon="{x:Bind PlayerAudio.VolumeIcon, Mode=OneWay}"
                            IsEnabled="{x:Bind AudioItem, Mode=OneWay, Converter={StaticResource InvertedIsNull}}"
                            Variant="Text" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="2"
                Padding="10"
                Background="{ThemeResource WindowBackground}"
                BorderBrush="{ThemeResource Border}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel VerticalAlignment="Bottom" Spacing="10">
                    <StackPanel Spacing="5">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{cme:SR K=Output}" />

                        <cui:TextBoxComp
                            HorizontalAlignment="Stretch"
                            PrefixIcon="&#xE838;"
                            Text="">
                            <cui:TextBoxComp.TextBoxStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="IsReadOnly" Value="True" />
                                </Style>
                            </cui:TextBoxComp.TextBoxStyle>
                            <cui:TextBoxComp.ActionButton>
                                <cui:IconButton Icon="&#xE8DA;" />
                            </cui:TextBoxComp.ActionButton>
                        </cui:TextBoxComp>
                    </StackPanel>

                    <Grid
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="10">
                        <cui:AZ
                            Grid.Column="1"
                            IsA="{x:Bind Status.IsProcessed, Mode=OneWay}"
                            IsB="{x:Bind Status.IsProcessing, Mode=OneWay}">
                            <cui:AZ.A>
                                <cui:IconButton
                                    Command="{x:Bind c:Commands.RevealInFileExplorerCommand}"
                                    CommandParameter="{x:Bind OutputPath}"
                                    Icon="&#xE8E5;"
                                    Variant="Text" />
                            </cui:AZ.A>
                            <cui:AZ.B>
                                <Grid>
                                    <ProgressRing
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource ProgressRingForeground}"
                                        IsIndeterminate="False"
                                        Value="{x:Bind Percent, Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Bind Percent, Mode=OneWay}" />
                                </Grid>
                            </cui:AZ.B>
                        </cui:AZ>

                        <cui:ABIconTextButton
                            Grid.Column="2"
                            Width="120"
                            CheckedText="{cme:SR K=Cancel}"
                            Command="{x:Bind ExportCommand}"
                            IsChecked="{x:Bind Status.IsNotProcessing, Mode=OneWay, Converter={StaticResource InvertedBool}}"
                            IsThemeEnabled="{x:Bind Status.IsNotProcessing, Mode=OneWay}"
                            Scheme="Theme"
                            Text="{cme:SR K=Export}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</app:MainWindowPage>
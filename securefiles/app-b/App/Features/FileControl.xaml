<?xml version="1.0" encoding="utf-8" ?>
<coreUI:UserControlEx
    x:Class="IOApp.Features.FileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:IOCore"
    xmlns:coreHelpers="using:IOCore.Helpers"
    xmlns:coreLibs="using:IOCore.Libs"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    d:DataContext="{d:DesignInstance Type=features:PrivateFileItem}"
    mc:Ignorable="d">
    <coreUI:UserControlEx.Resources>
        <MenuFlyout x:Name="ItemMenuFlyout" Placement="Bottom">
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Tag="ViewOrPlay"
                Text="{coreHelpers:SRE K=View}"
                Visibility="{Binding FileType, ConverterParameter=Image, Converter={StaticResource EnumComparisonToBoolConverter}}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE91B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Tag="ViewOrPlay"
                Text="{coreHelpers:SRE K=Play}"
                Visibility="{Binding FileType, ConverterParameter=Video|Audio, Converter={StaticResource EnumComparisonToBoolConverter}}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Tag="Censor"
                Text="{coreHelpers:SRE K=Features_Unblur}"
                Visibility="{Binding Censor, ConverterParameter=Blur, Converter={StaticResource EnumComparisonToBoolConverter}}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEA18;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Tag="Censor"
                Text="{coreHelpers:SRE K=Features_Blur}"
                Visibility="{Binding Censor, ConverterParameter=None, Converter={StaticResource EnumComparisonToBoolConverter}}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEA18;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Tag="Export"
                Text="{coreHelpers:SRE K=Export}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE898;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Tag="Properties"
                Text="{coreHelpers:SRE K=Properties}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Foreground="{ThemeResource Failure}"
                Tag="RemovePermanently"
                Text="{coreHelpers:SRE K=RemovePermanently}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <MenuFlyout x:Name="CorruptedItemMenuFlyout" Placement="Bottom">
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Tag="Properties"
                Text="{coreHelpers:SRE K=Properties}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="MenuItemButton_Click"
                Foreground="{ThemeResource Failure}"
                Tag="RemovePermanently"
                Text="{coreHelpers:SRE K=RemovePermanently}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </coreUI:UserControlEx.Resources>
    <Grid
        Width="256"
        Height="350"
        Background="{ThemeResource IconItemBackgroundGroup}">

        <Grid
            DoubleTapped="Item_DoubleTapped"
            RowDefinitions="256,*"
            Visibility="{Binding IsCorrupted, Converter={StaticResource BoolNegationConverter}}">
            <Grid Width="256" Height="256">
                <FontIcon
                    FontSize="64"
                    Foreground="{ThemeResource Foreground2}"
                    Glyph="&#xE8B7;"
                    Visibility="{Binding FileType, ConverterParameter=Directory, Converter={StaticResource EnumComparisonToBoolConverter}}" />
                <FontIcon
                    FontSize="64"
                    Foreground="{ThemeResource Foreground2}"
                    Glyph="&#xE8A5;"
                    Visibility="{Binding FileType, ConverterParameter=Document|Unknown, Converter={StaticResource EnumComparisonToBoolConverter}}" />
                <Image
                    Source="{Binding Thumbnail}"
                    UseLayoutRounding="False"
                    Visibility="{Binding FileType, ConverterParameter=Video|Image, Converter={StaticResource EnumComparisonToBoolConverter}}" />
                <FontIcon
                    FontSize="64"
                    Foreground="{ThemeResource Foreground2}"
                    Glyph="&#xEC4F;"
                    Visibility="{Binding FileType, ConverterParameter=Audio, Converter={StaticResource EnumComparisonToBoolConverter}}" />
            </Grid>
            <Grid
                Grid.Row="1"
                Padding="15"
                RowDefinitions="*,Auto">
                <TextBlock
                    FontSize="14"
                    MaxLines="2"
                    Text="{Binding OriginalInfo.Name, ConverterParameter=64, Converter={StaticResource TrimStringConverter}}"
                    TextWrapping="Wrap"
                    ToolTipService.ToolTip="{Binding OriginalInfo.Name}" />
                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="5">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource Foreground2}"
                        Text="{Binding EncryptedInfo.CreationTime, Converter={StaticResource DateTimeToStringConverter}}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource Foreground2}"
                        Text="{Binding EncryptedInfo.FileSize, Converter={StaticResource FileSizeToStringConverter}}"
                        Visibility="{Binding FileType, ConverterParameter=Directory, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}" />
                </StackPanel>
            </Grid>

            <Border Grid.RowSpan="2" Visibility="{Binding Censor, ConverterParameter=Blur, Converter={StaticResource EnumComparisonToBoolConverter}}">
                <Border.Background>
                    <media:BackdropBlurBrush Amount="24" />
                </Border.Background>
            </Border>
        </Grid>

        <StackPanel
            Padding="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsCorrupted}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="64"
                Foreground="{ThemeResource Foreground2}"
                Glyph="&#xE814;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="10"
                MaxLines="2"
                Text="{Binding OriginalInfo.Name}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Margin="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="5">
            <coreUI:ABIconButton
                BIcon="&#xE768;"
                Click="MenuItemButton_Click"
                Icon="&#xE91B;"
                IsAOrB="{Binding FileType, ConverterParameter=Image, Converter={StaticResource EnumComparisonToBoolConverter}}"
                IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                IsSquare="True"
                Size="SM"
                Tag="ViewOrPlay"
                Visibility="{Binding FileType, ConverterParameter=Image|Video|Audio, Converter={StaticResource EnumComparisonToBoolConverter}}" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="5"
                Visibility="{Binding InputInfo.IsCorrupted, Converter={StaticResource BoolNegationConverter}}">
                <coreUI:ABIconButton
                    BIcon="&#xEA18;"
                    Click="MenuItemButton_Click"
                    Icon="&#xEA18;"
                    IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                    IsSquare="True"
                    IsTheme="{Binding Censor, ConverterParameter=Blur, Converter={StaticResource EnumComparisonToBoolConverter}}"
                    Size="SM"
                    Tag="Censor" />
            </StackPanel>

            <coreUI:IconButton
                Click="MenuItemButton_Click"
                Icon="&#xe712;"
                IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                IsSquare="True"
                Size="SM"
                Tag="Menu" />
        </StackPanel>
    </Grid>
</coreUI:UserControlEx>
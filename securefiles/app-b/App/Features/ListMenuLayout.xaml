<?xml version="1.0" encoding="utf-8" ?>
<coreUI:UserControlEx
    x:Class="IOApp.Features.ListMenuLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=features:ListMenuLayout}"
    mc:Ignorable="d">
    <StackPanel Spacing="5">
        <Grid
            Height="32"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="15">
            <TextBlock
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="{x:Bind Title, Mode=OneWay}" />
            <ContentPresenter
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="{x:Bind TitlePanel, Mode=OneWay}" />
        </Grid>
        <StackPanel CornerRadius="10">
            <Border Background="{ThemeResource PageBackground}">
                <TextBlock
                    Margin="15,10"
                    MaxLines="2"
                    Text="{x:Bind EmptyText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Border>
            <ContentPresenter Content="{x:Bind ContentPanel, Mode=OneWay}" Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
        </StackPanel>
    </StackPanel>
</coreUI:UserControlEx>
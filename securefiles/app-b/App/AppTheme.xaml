<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreHelpers="using:IOCore.Helpers">
    <Color x:Key="ThemeColor">#FFC107</Color>
    <Color x:Key="ThemeSecondaryColor">#FFC107</Color>

    <SolidColorBrush x:Key="Theme" Color="{StaticResource ThemeColor}" />
    <SolidColorBrush x:Key="ThemeSecondary" Color="{StaticResource ThemeSecondaryColor}" />

    <SolidColorBrush x:Key="ThemeLighter" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, BrightnessFactor=0.1}" />
    <SolidColorBrush x:Key="ThemeDarker" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, BrightnessFactor=-0.1}" />
    <SolidColorBrush x:Key="ThemeDarkest" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, BrightnessFactor=-0.9}" />
    <SolidColorBrush
        x:Key="ThemeOpacity"
        Opacity="0.04"
        Color="{StaticResource ThemeColor}" />

    <SolidColorBrush x:Key="ThemeForeground" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, UseContrast=True}" />
    <SolidColorBrush x:Key="ThemeForegroundDisabled" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, UseContrast=True}" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush
                x:Key="HudBackground"
                Opacity="0.7"
                Color="#000000" />
            <SolidColorBrush
                x:Key="ItemBackground"
                Opacity="0.1"
                Color="#fff" />
            <SolidColorBrush
                x:Key="ItemSelectedBackground"
                Opacity="0.2"
                Color="#fff" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush
                x:Key="HudBackground"
                Opacity="0.7"
                Color="#000000" />
            <SolidColorBrush
                x:Key="ItemBackground"
                Opacity="0.1"
                Color="#fff" />
            <SolidColorBrush
                x:Key="ItemSelectedBackground"
                Opacity="0.2"
                Color="#fff" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush
                x:Key="HudBackground"
                Opacity="0.7"
                Color="#ffffff" />
            <SolidColorBrush
                x:Key="ItemBackground"
                Opacity="0.1"
                Color="#000" />
            <SolidColorBrush
                x:Key="ItemSelectedBackground"
                Opacity="0.2"
                Color="#000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
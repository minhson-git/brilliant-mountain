<core:DialogEx
    x:Class="IOApp.Popups.PreferencesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:IOCore"
    xmlns:coreHelpers="using:IOCore.Helpers"
    xmlns:coreLibs="using:IOCore.Libs"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:popups="using:IOApp.Popups"
    d:DataContext="{d:DesignInstance Type=popups:PreferencesDialog}"
    mc:Ignorable="d">
    <Grid Width="450">
        <StackPanel Padding="15" Spacing="15">
            <StackPanel Spacing="5">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Text="{coreHelpers:SRE K=Features_PreferenceTitle}" />
                <TextBlock
                    FontSize="14"
                    Text="{coreHelpers:SRE K=Features_PreferenceDesc}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <StackPanel
                Padding="0,15"
                BorderBrush="{ThemeResource Border}"
                BorderThickness="0,1"
                Spacing="10">
                <TextBlock FontWeight="Bold" Text="{coreHelpers:SRE K=Features_ChangePasswordTitle}" />
                <TextBlock
                    FontSize="14"
                    Text="{coreHelpers:SRE K=Features_ChangePasswordSubtitle}"
                    TextWrapping="WrapWholeWords" />
                <PasswordBox
                    Name="CurrentPasswordBox"
                    IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                    PlaceholderText="{coreHelpers:SRE K=Features_CurrentPassword}" />
                <PasswordBox
                    Name="NewPasswordBox"
                    IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                    PlaceholderText="{coreHelpers:SRE K=Features_NewPassword}" />
                <PasswordBox
                    Name="ConfirmPasswordBox"
                    IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                    PlaceholderText="{coreHelpers:SRE K=Features_ConfirmPassword}" />
                <TextBlock Text="{Binding ErrorText}" />
                <coreUI:IconTextButton
                    Click="ActionButton_Click"
                    IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                    IsTheme="True"
                    Tag="ChangePassword"
                    Text="{coreHelpers:SRE K=Apply}" />
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="{coreHelpers:SRE K=Features_ConfigureLocationTitle}" />
                        <TextBlock
                            FontSize="14"
                            Text="{coreHelpers:SRE K=Features_ConfigureLocationSubtitle}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        Click="ActionButton_Click"
                        Content="{coreHelpers:SRE K=Features_ResetDefault}"
                        IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                        Tag="ResetStoragePath" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
                    <TextBox
                        Name="StorageFolderPathTextBox"
                        Padding="7,7,0,0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="3,0,0,3"
                        FontSize="12"
                        IsReadOnly="True" />
                    <coreUI:IconButton
                        Grid.Column="1"
                        Click="ActionButton_Click"
                        Corner="Right"
                        Icon="&#xE8DA;"
                        IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                        Tag="BrowseStoragePath" />
                    <coreUI:IconButton
                        Grid.Column="2"
                        Click="ActionButton_Click"
                        Icon="&#xE8C8;"
                        IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                        IsSquare="True"
                        Tag="CopyStoragePath"
                        Variant="Text" />
                </Grid>
                <coreUI:IconTextButton
                    Click="ActionButton_Click"
                    IsEnabled="{Binding Status.S, ConverterParameter=Loading, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                    IsTheme="True"
                    Tag="ChangeStoragePath"
                    Text="{coreHelpers:SRE K=Apply}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</core:DialogEx>
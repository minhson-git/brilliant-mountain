<?xml version="1.0" encoding="utf-8" ?>
<core:WindowEx
    x:Class="IOApp.CoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:apps="using:IOApp"
    xmlns:core="using:IOCore"
    xmlns:coreHelpers="using:IOCore.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:notifyIcon="using:H.NotifyIcon"
    mc:Ignorable="d">
    <Grid d:DataContext="{d:DesignInstance Type=apps:CoreWindow}">
        <Grid.Resources>
            <apps:CoreWindowProxy x:Name="Proxy" Data="{Binding}" />
        </Grid.Resources>
        <notifyIcon:TaskbarIcon
            x:Name="TaskbarIcon"
            x:FieldModifier="public"
            ContextMenuMode="SecondWindow"
            IconSource="ms-appx:///App/Externals/icon.ico"
            LeftClickCommand="{Binding TaskbarIconActionCommand}"
            LeftClickCommandParameter="ShowWindow"
            NoLeftClickDelay="True"
            ToolTipText="{Binding AppWindow.Title}">
            <notifyIcon:TaskbarIcon.ContextFlyout>
                <MenuFlyout AreOpenCloseAnimationsEnabled="False">
                    <MenuFlyoutItem
                        Width="180"
                        Command="{Binding Data.TaskbarIconActionCommand, Source={StaticResource Proxy}}"
                        CommandParameter="Play"
                        Text="{coreHelpers:SRE K=Play}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{Binding Data.TaskbarIconActionCommand, Source={StaticResource Proxy}}"
                        CommandParameter="Convert"
                        Text="{coreHelpers:SRE K=Convert}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xEA69;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{Binding Data.TaskbarIconActionCommand, Source={StaticResource Proxy}}"
                        CommandParameter="Download"
                        Text="{coreHelpers:SRE K=VideoDownloader}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xEBD3;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Command="{Binding Data.TaskbarIconActionCommand, Source={StaticResource Proxy}}"
                        CommandParameter="Premium"
                        Text="{coreHelpers:SRE K=Premium}"
                        Visibility="{Binding Data.LicenseStatus.IsTrial, Source={StaticResource Proxy}}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE728;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{Binding Data.TaskbarIconActionCommand, Source={StaticResource Proxy}}"
                        CommandParameter="ExitApp"
                        Text="{coreHelpers:SRE K=Exit}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xF3B1;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </notifyIcon:TaskbarIcon.ContextFlyout>
        </notifyIcon:TaskbarIcon>
    </Grid>
</core:WindowEx>
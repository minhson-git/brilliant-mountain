<?xml version="1.0" encoding="utf-8" ?>
<dialogs:DialogEx
    x:Class="IOApp.Dialogs.UnlockDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreHelpers="using:IOCore.Helpers"
    xmlns:coreLibs="using:IOCore.Libs"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:IOCore.Dialogs"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:popups="using:IOApp.Dialogs"
    d:DataContext="{d:DesignInstance Type=popups:UnlockDialog}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <dialogs:DialogEx.Resources>
        <Flyout x:Name="ItemInfoFlyout">
            <StackPanel
                Width="320"
                d:DataContext="{d:DesignInstance Type=features:CypherFileItem}"
                Spacing="5">
                <TextBlock
                    FontSize="12"
                    FontWeight="Bold"
                    Text="{coreHelpers:SRE K=FileInfo}" />
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="12"
                        Text="{coreHelpers:SRE K=Name}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding InputInfo.Name}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="12"
                        Text="{coreHelpers:SRE K=Location}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding InputInfo.FullName}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        FontSize="12"
                        Text="{coreHelpers:SRE K=FileSize}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding InputInfo.FileSize, Converter={StaticResource FileSizeToStringConverter}}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        FontSize="12"
                        Text="{coreHelpers:SRE K=DateCreated}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding InputInfo.CreationTimeText}" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        FontSize="12"
                        Text="{coreHelpers:SRE K=DateModified}" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding InputInfo.LastWriteTimeText}" />
                </Grid>
            </StackPanel>
        </Flyout>
    </dialogs:DialogEx.Resources>

    <Grid
        Width="800"
        Height="600"
        RowDefinitions="Auto,*"
        RowSpacing="15">
        <Grid
            Padding="10"
            ColumnDefinitions="Auto"
            ColumnSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <StackPanel MinWidth="70">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{ThemeResource Foreground2}"
                            Text="{coreHelpers:SRE K=Last}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Text="{Binding LastRun}" />
                    </StackPanel>
                    <StackPanel MinWidth="70">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{ThemeResource Foreground2}"
                            Text="{coreHelpers:SRE K=Time}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Text="{Binding TimeRun}" />
                    </StackPanel>
                    <StackPanel MinWidth="70">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{ThemeResource Foreground2}"
                            Text="{coreHelpers:SRE K=Files}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Text="{Binding FileItems.Count}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!--  FILES  -->
            <ListView
                Padding="0,2,0,210"
                Background="{ThemeResource ListViewBackground}"
                CornerRadius="5,5,0,0"
                ItemsSource="{Binding FileItems}"
                SelectionMode="None"
                Visibility="{Binding FileItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="0,10,3,10"
                            ColumnDefinitions="*,200"
                            ColumnSpacing="10"
                            Opacity="{Binding IsAvailable, Converter={StaticResource BoolToDouble_D_D}}">
                            <Grid ColumnDefinitions="*">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{Binding InputInfo.Name}"
                                            ToolTipService.ToolTip="{Binding InputInfo.Name}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource Foreground2}"
                                        Text="{Binding InputInfo.FullName}"
                                        ToolTipService.ToolTip="{Binding InputInfo.FullName}" />
                                    <StackPanel Orientation="Horizontal" Spacing="20">
                                        <coreUI:IconTextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource Foreground2}"
                                            Icon="&#xE823;"
                                            Spacing="5"
                                            Text="{Binding InputInfo.LastWriteTimeText}" />
                                        <coreUI:IconTextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource Foreground2}"
                                            Icon="&#xE8A5;"
                                            Spacing="5"
                                            Text="{Binding InputInfo.FileSize, Converter={StaticResource FileSizeToStringConverter}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <StackPanel Orientation="Horizontal">
                                        <coreUI:IconButton
                                            Flyout="{StaticResource ItemInfoFlyout}"
                                            Icon="&#xE946;"
                                            Variant="Text" />
                                        <coreUI:IconButton
                                            Click="RemoveOneButton_Click"
                                            Icon="&#xE711;"
                                            IsEnabled="{Binding IsEnabled}"
                                            Variant="Text" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Visibility="{Binding Status.S, ConverterParameter=Processing, Converter={StaticResource EnumComparisonToBoolConverter}}">
                                        <ProgressRing
                                            Width="20"
                                            Height="20"
                                            Foreground="{ThemeResource ProgressRingForeground}"
                                            IsActive="True" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource Failure}"
                                    Text="{Binding MessageText}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  CONFIGS  -->
            <StackPanel
                Name="OutputConfigPanel"
                Margin="10,0,0,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource WindowBackground}"
                BorderBrush="{ThemeResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Orientation="Horizontal">

                <!--  STANDARD OUTPUT  -->
                <StackPanel Width="270" Padding="20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="{coreHelpers:SRE K=Password}" />
                        <PasswordBox
                            Name="InputPasswordBox"
                            Grid.Column="1"
                            IsEnabled="{Binding Status.S, ConverterParameter=Loading|Processing, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}" />
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <coreUI:IconTextButton
                            x:Name="ProcessAllButton"
                            Click="ProcessAllButton_Click"
                            Icon="&#xE785;"
                            IsEnabled="{Binding Status.S, ConverterParameter=Loading|Processing, Converter={StaticResource InvertedEnumComparisonToBoolConverter}}"
                            IsTheme="True"
                            Text="{coreHelpers:SRE K=Features_UnlockAll}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</dialogs:DialogEx>
<?xml version="1.0" encoding="utf-8" ?>
<coreUI:BaseIconTextButton
    x:Class="IOApp.UI.VIconTextButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreConverters="using:IOCore.Converters"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:IOApp.UI"
    d:DataContext="{d:DesignInstance Type=ui:VIconTextButton}"
    mc:Ignorable="d">

    <coreUI:BaseIconTextButton.Resources>
        <coreConverters:BoolToDoubleConverter
            x:Key="BoolToDouble_1D0_0D4_Converter"
            FalseValue="0.4"
            TrueValue="1.0" />

        <Style x:Key="BackgroundStyle" TargetType="Button">
            <Style.Setters>
                <Setter Property="Height" Value="80" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style.Setters>
        </Style>
        <Style x:Key="IconBorderStyle" TargetType="Border">
            <Setter Property="Visibility" Value="{x:Bind Icon, Converter={StaticResource InvertedIsNullOrEmptyStringToVisibilityConverter}}" />
        </Style>
        <Style x:Key="IconStyle" TargetType="FontIcon">
            <Style.Setters>
                <Setter Property="Glyph" Value="{x:Bind ControlIcon, Mode=OneWay}" />
                <Setter Property="FontSize" Value="{x:Bind IconSize}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style.Setters>
        </Style>
        <Style x:Key="TextStyle" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Text" Value="{x:Bind ControlText, Mode=OneWay}" />
                <Setter Property="FontSize" Value="{x:Bind TextSize}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style.Setters>
        </Style>
    </coreUI:BaseIconTextButton.Resources>

    <coreUI:AZ Height="80" IsA="{x:Bind IsLoading, Mode=OneWay}">
        <coreUI:AZ.A>
            <Grid RowDefinitions="Auto,*" RowSpacing="5">
                <Border Width="{x:Bind ControlHeight}" Height="{x:Bind ControlHeight}">
                    <ProgressRing
                        Width="{x:Bind ControlHeight, ConverterParameter=-6, Converter={StaticResource DoubleAddConverter}}"
                        Height="{x:Bind ControlHeight, ConverterParameter=-6, Converter={StaticResource DoubleAddConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource ProgressRingForeground}"
                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                        Value="{x:Bind LoadingValue, Mode=OneWay}" />
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Margin="{x:Bind TextPadding}"
                    Style="{StaticResource TextStyle}"
                    Text="{x:Bind LoadingText, Mode=OneWay}" />
            </Grid>
        </coreUI:AZ.A>
        <coreUI:AZ.B>
            <Grid Opacity="{x:Bind IsEnabled, Mode=OneWay, Converter={StaticResource BoolToDouble_1D0_0D4_Converter}}">
                <coreUI:AZ IsA="{x:Bind IsTheme, Mode=OneWay}" IsB="{x:Bind IsTheme2nd, Mode=OneWay}">
                    <coreUI:AZ.A>
                        <Button
                            CornerRadius="{x:Bind ControlCornerRadius}"
                            Flyout="{x:Bind Flyout}"
                            Loaded="OnLoaded"
                            Style="{StaticResource BackgroundStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="5">
                                <Border Style="{StaticResource IconBorderStyle}">
                                    <FontIcon Style="{StaticResource IconStyle}" />
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="{x:Bind TextPadding}"
                                    Style="{StaticResource TextStyle}" />
                            </Grid>
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="ThemeForeground" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="ThemeForeground" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="ThemeForeground" />
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="Theme" />
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="Theme" />
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="Theme" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                        </Button>
                    </coreUI:AZ.A>
                    <coreUI:AZ.B>
                        <Button
                            CornerRadius="{x:Bind ControlCornerRadius}"
                            Flyout="{x:Bind Flyout}"
                            Loaded="OnLoaded"
                            Style="{StaticResource BackgroundStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="5">
                                <Border Style="{StaticResource IconBorderStyle}">
                                    <FontIcon Style="{StaticResource IconStyle}" />
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="{x:Bind TextPadding}"
                                    Style="{StaticResource TextStyle}" />
                            </Grid>
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="ThemeForeground" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="ThemeForeground" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="ThemeForeground" />
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="ThemeSecondary" />
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ThemeSecondary" />
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ThemeSecondary" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                        </Button>
                    </coreUI:AZ.B>
                    <coreUI:AZ.C>
                        <Button
                            Background="{x:Bind BackgroundBrush, Mode=OneWay}"
                            BorderThickness="{x:Bind ControlThickness, Mode=OneWay}"
                            CornerRadius="{x:Bind ControlCornerRadius}"
                            Flyout="{x:Bind Flyout}"
                            Loaded="OnLoaded"
                            Style="{StaticResource BackgroundStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="5">
                                <Border Style="{StaticResource IconBorderStyle}">
                                    <FontIcon Foreground="{x:Bind Foreground}" Style="{StaticResource IconStyle}" />
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="{x:Bind TextPadding}"
                                    Foreground="{x:Bind Foreground}"
                                    Style="{StaticResource TextStyle}" />
                            </Grid>
                        </Button>
                    </coreUI:AZ.C>
                </coreUI:AZ>
                <Border
                    Width="8"
                    Height="8"
                    Margin="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{ThemeResource Theme}"
                    CornerRadius="4"
                    Visibility="{x:Bind IsBadgeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </coreUI:AZ.B>
    </coreUI:AZ>
</coreUI:BaseIconTextButton>
<?xml version="1.0" encoding="utf-8" ?>
<dialogs:VolumeFeatureDialog
    x:Class="IOApp.Dialogs.CleanVolumeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:IOCore"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:IOApp.Dialogs"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:CleanVolumeDialog}"
    mc:Ignorable="d">

    <dialogs:VolumeFeatureDialog.Resources>
        <dialogs:CleanVolumeDialogProxy x:Name="Proxy" Data="{Binding}" />
    </dialogs:VolumeFeatureDialog.Resources>

    <Grid>
        <Grid
            Width="600"
            Height="540"
            Padding="10"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="10">
            <coreUI:IconTextBlock
                Icon="&#xF413;"
                Size="XL"
                Text="{core:SRE K=Clean}" />

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding VolumeItems.Items.Count, Converter={StaticResource VolumeCounterConverter}}" />
                    <Run Text=" : " />
                    <Run Text="{Binding VolumeItems.CheckedCount}" />
                    <Run Text=" / " />
                    <Run Text="{Binding VolumeItems.Items.Count}" />
                </TextBlock>

                <CheckBox
                    Grid.Column="2"
                    MinWidth="40"
                    FlowDirection="RightToLeft"
                    IsChecked="{Binding VolumeItems.IsChecked, Mode=TwoWay}"
                    IsEnabled="{Binding Status.IsNotBusy}" />
            </Grid>

            <ListView
                Grid.Row="2"
                Background="{ThemeResource ListViewBackground}"
                CornerRadius="5"
                ItemsSource="{Binding VolumeItems.Items}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="5,10">
                            <Grid ColumnDefinitions="60,*,Auto" CornerRadius="5">
                                <Grid
                                    Height="60"
                                    Padding="10"
                                    Background="{ThemeResource Foreground2}"
                                    CornerRadius="2">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Target.Name}" />
                                </Grid>

                                <Grid
                                    Grid.Column="1"
                                    Margin="10"
                                    RowDefinitions="Auto,Auto,Auto"
                                    RowSpacing="5">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock FontSize="12" Text="{Binding Target.VolumeName}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            FontSize="10"
                                            Text="{Binding Target.FileSystem}" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Row="1"
                                        VerticalAlignment="Top"
                                        Spacing="5">
                                        <TextBlock FontSize="12">
                                            <Run Text="{core:SRE K=Free}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Target.FreeSpace, Converter={StaticResource FileSizeToStringConverter}}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding Target.Size, Converter={StaticResource FileSizeToStringConverter}}" />
                                        </TextBlock>
                                        <TextBlock
                                            FontSize="12"
                                            FontStyle="Italic"
                                            Foreground="{ThemeResource Foreground2}">
                                            <Run Text="{core:SRE K=Used}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Target.UsedSize, Converter={StaticResource FileSizeToStringConverter}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                                    <CheckBox
                                        MinWidth="20"
                                        HorizontalAlignment="Right"
                                        FlowDirection="RightToLeft"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                    <features:FileBadge Grid.Row="2" DataContext="{Binding Target}" />
                                </Grid>
                            </Grid>
                            <coreUI:AZ
                                IsA="{Binding Target.Status.IsProcessing}"
                                IsB="{Binding Target.Status.IsProcessed}"
                                IsC="{Binding Target.Status.S, ConverterParameter=ProcessStopped;ProcessFailed, Converter={StaticResource IsEqualEnumsConverter}}">
                                <coreUI:AZ.A>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontSize="12" Glyph="&#xF413;" />
                                        <TextBlock FontSize="12" Text="{Binding Target.Info}" />
                                    </StackPanel>
                                </coreUI:AZ.A>
                                <coreUI:AZ.B>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource Success}"
                                        Text="{Binding Target.Status.T}" />
                                </coreUI:AZ.B>
                                <coreUI:AZ.C>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource Failure}"
                                            Text="{Binding Target.Message, ConverterParameter=40, Converter={StaticResource TrimStringConverter}}" />
                                        <coreUI:InfoButton Desc="{Binding Target.Message}" />
                                    </StackPanel>
                                </coreUI:AZ.C>
                            </coreUI:AZ>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <coreUI:IconTextButton
                    Width="200"
                    Command="{Binding CleanEmptyFolderCommand}"
                    IsEnabled="{Binding Status.IsNotBusy}"
                    IsEnabled0="{Binding VolumeItems.IsAnyChecked}"
                    IsEnabled1="{Binding Status.IsNotBusy}"
                    IsTheme="True"
                    Text="{core:SRE K=CleanEmptyFolder}" />

                <coreUI:IconTextButton
                    Width="200"
                    Command="{Binding CleanAllCommand}"
                    IsEnabled="{Binding Status.IsNotBusy}"
                    IsEnabled0="{Binding VolumeItems.IsAnyChecked}"
                    IsTheme="True"
                    Text="{core:SRE K=CleanAll}" />
            </StackPanel>
        </Grid>
    </Grid>
</dialogs:VolumeFeatureDialog>
<?xml version="1.0" encoding="utf-8" ?>
<dialogs:VolumeFeatureDialog
    x:Class="IOApp.Dialogs.SettingUSBDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:IOCore"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:IOApp.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:SettingUSBDialog}"
    mc:Ignorable="d">

    <Grid>
        <StackPanel
            Width="420"
            Padding="10"
            Spacing="10">
            <coreUI:IconTextBlock Icon="&#xEDA2;" Size="XL">
                <coreUI:IconTextBlock.Content>
                    <TextBlock>
                        <Run Text="{core:SRE K=Format}" />
                        <Run Text="{Binding VolumeItem.VolumeName}" />
                        <Run Text=" (" />
                        <Run Text="{Binding VolumeItem.Name}" />
                        <Run Text=")" />
                    </TextBlock>
                </coreUI:IconTextBlock.Content>
            </coreUI:IconTextBlock>

            <StackPanel Spacing="5">
                <TextBlock
                    FontSize="11"
                    FontWeight="Bold"
                    Text="{core:SRE K=VolumeName}" />

                <coreUI:TextBoxComp
                    Name="VolumeNameTextBox"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding Status.IsNotBusy}"
                    PlaceholderText="{Binding VolumeItem.VolumeName}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock
                    FontSize="11"
                    FontWeight="Bold"
                    Text="{core:SRE K=ChangeFormat}" />

                <coreUI:ComboBoxEx
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding UsbFileSystemItems}"
                    SelectedIndex="{Binding UsbFileSystemIndex, Mode=TwoWay}" />
            </StackPanel>

            <!--<coreUI:CheckBoxEx Content="Is Read-Only" IsChecked="{Binding IsReadOnly, Mode=TwoWay}" />-->

            <coreUI:IconTextButton
                Width="120"
                HorizontalAlignment="Center"
                Command="{Binding SaveCommand}"
                IsTheme="True"
                Text="{core:SRE K=Save}" />
        </StackPanel>
    </Grid>
</dialogs:VolumeFeatureDialog>
<?xml version="1.0" encoding="utf-8" ?>
<core:WindowEx
    x:Class="IOApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:apps="using:IOApp"
    xmlns:core="using:IOCore"
    xmlns:coreAppManager="using:IOCore.AppManager"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:IOApp.Pages"
    mc:Ignorable="d">

    <Grid d:DataContext="{d:DesignInstance Type=apps:MainWindow}" Background="{ThemeResource WindowBackground}">
        <Grid.Resources>
            <apps:MainWindowProxy x:Name="Proxy" Data="{Binding}" />
        </Grid.Resources>

        <Grid RowDefinitions="Auto,*">
            <coreUI:TitleBarEx
                x:Name="TitleBar"
                x:FieldModifier="Public"
                IsBackButtonEnabled="{Binding Status.IsNotBusy}"
                IsIconVisible="False"
                IsPaneToggleButtonVisible="True"
                IsSubtitleVisible="False"
                IsTitleVisible="False">
                <coreUI:TitleBarEx.LeftHeader>
                    <StackPanel
                        Margin="0,0,10,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <coreUI:IconButton
                            Command="{Binding Menu.ShowMenuCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Icon="&#xE712;"
                            Variant="Text" />
                        <coreUI:IconButton
                            Command="{Binding ShowSupportDialogCommand}"
                            Icon="&#xED15;"
                            Variant="Text" />
                        <coreUI:IconButton
                            Name="PromotionAppItemButton"
                            Command="{Binding Menu.ShowPromotionCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Icon="&#xE719;"
                            Variant="Text"
                            Visibility="{Binding PromotionAppItems.IsNotEmpty}" />
                    </StackPanel>
                </coreUI:TitleBarEx.LeftHeader>
                <!--<coreUI:TitleBarEx.RightHeader>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <coreUI:IconTextButton
                            Command="{Binding ShowUpdatePremiumCommand}"
                            Icon="&#xE728;"
                            IsTheme="True"
                            Text="Update to Premium" />
                    </StackPanel>
                </coreUI:TitleBarEx.RightHeader>-->
            </coreUI:TitleBarEx>

            <coreUI:NavigationViewEx
                x:Name="NavigationView"
                Grid.Row="1"
                x:FieldModifier="Public"
                BorderThickness="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="True"
                PaneDisplayMode="LeftCompact">
                <coreUI:NavigationViewEx.MenuItems>
                    <coreUI:NavigationViewItemEx Content="{core:SRE K=Volumes}" PageType="{core:X T=pages:Volumes}">
                        <coreUI:NavigationViewItemEx.Icon>
                            <FontIcon Glyph="&#xEB05;" />
                        </coreUI:NavigationViewItemEx.Icon>
                    </coreUI:NavigationViewItemEx>
                    <coreUI:NavigationViewItemEx Content="{core:SRE K=Disks}" PageType="{core:X T=pages:Disks}">
                        <coreUI:NavigationViewItemEx.Icon>
                            <FontIcon Glyph="&#xEDA2;" />
                        </coreUI:NavigationViewItemEx.Icon>
                    </coreUI:NavigationViewItemEx>
                </coreUI:NavigationViewEx.MenuItems>

                <Grid RowDefinitions="*,Auto">
                    <Frame Name="_frame" Background="{ThemeResource PageBackground}" />

                    <!--<Grid
                        Grid.Row="1"
                        Padding="10,0,10,10"
                        Background="{ThemeResource PageBackground}"
                        ColumnDefinitions="Auto,*,Auto"
                        Visibility="{Binding License.Status.IsTrial}">
                        <coreAppManager:PromotionApp
                            DataContext="{Binding PromotionAppItems.FirstOrDefault}"
                            IsLite="True"
                            Visibility="{Binding Data.PromotionAppItems.IsNotEmpty, Source={StaticResource Proxy}}" />
                        <features:TrialInfoButton
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>-->
                </Grid>
            </coreUI:NavigationViewEx>
        </Grid>
    </Grid>
</core:WindowEx>
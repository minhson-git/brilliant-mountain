<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="IOApp.Features.TrialInfoButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=features:TrialInfoButton}"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock
            VerticalAlignment="Center"
            Foreground="{ThemeResource Brand}"
            Text="{x:Bind Title}" />
        <coreUI:InfoButton Title="{x:Bind Title}" Desc="{x:Bind Desc}" />
    </StackPanel>
</UserControl>
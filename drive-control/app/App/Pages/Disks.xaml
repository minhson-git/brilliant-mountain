<?xml version="1.0" encoding="utf-8" ?>
<apps:MainWindowPage
    x:Class="IOApp.Pages.Disks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appUI="using:IOApp.UI"
    xmlns:apps="using:IOApp"
    xmlns:core="using:IOCore"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:IOApp.Pages"
    d:DataContext="{d:DesignInstance Type=pages:Disks}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <apps:MainWindowPage.Resources>
        <pages:DisksProxy x:Name="Proxy" Data="{Binding}" />

        <MenuFlyout
            x:Name="VolumeMenuFlyout"
            d:DataContext="{d:DesignInstance Type=features:VolumeItem}"
            Placement="Bottom">
            <MenuFlyoutItem
                Command="{Binding Data.ShowSettingsVolumeCommand, Source={StaticResource Proxy}}"
                CommandParameter="{Binding}"
                Text="{core:SRE K=Settings}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Command="{Binding Data.ShowSyncVolumesCommand, Source={StaticResource Proxy}}"
                CommandParameter="{Binding}"
                Text="{core:SRE K=Sync}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE895;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Command="{Binding Data.Window.RevealInFileExplorerCommand, Source={StaticResource Proxy}}"
                CommandParameter="{Binding Path}"
                Text="{core:SRE K=Features_OpenLocation}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8DA;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </apps:MainWindowPage.Resources>

    <Grid ColumnDefinitions="360,*">
        <coreUI:AZ IsA="{Binding DiskItems.IsEmpty}">
            <coreUI:AZ.A>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="80"
                        Glyph="&#xEDA2;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{core:SRE K=InsertDriveMessage}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </coreUI:AZ.A>
            <coreUI:AZ.B>
                <Grid
                    Padding="5"
                    RowDefinitions="Auto,*,Auto"
                    RowSpacing="10">
                    <TextBlock HorizontalAlignment="Left">
                        <Run Text="{core:SRE K=USBConnected}" />
                        <Run Text=" : " />
                        <Run Text="{Binding DiskItems.Count}" />
                    </TextBlock>

                    <ListView
                        Grid.Row="1"
                        IsEnabled="{Binding Status.IsNotLoading}"
                        ItemsSource="{Binding DiskItems}"
                        SelectedItem="{Binding SelectedDiskItem, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="5,10"
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="5"
                                    CornerRadius="5">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="50"
                                        Glyph="&#xE88E;" />

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <TextBlock FontSize="14" Text="{Binding Caption}" />
                                        <TextBlock FontSize="12" Text="{Binding Size, Converter={StaticResource FileSizeToStringConverter}}" />
                                    </StackPanel>

                                    <coreUI:IconButton
                                        Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Command="{Binding EjectCommand}"
                                        CommandParameter="One"
                                        Icon="&#xF847;" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <coreUI:IconTextButton
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding EjectCommand}"
                        CommandParameter="All"
                        Icon="&#xF847;"
                        Text="{core:SRE K=EjectAll}" />
                </Grid>
            </coreUI:AZ.B>
        </coreUI:AZ>

        <Grid
            Grid.Column="2"
            Padding="10"
            Background="{ThemeResource DockBackground}"
            CornerRadius="5"
            RowDefinitions="*,Auto,Auto"
            RowSpacing="10">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{core:SRE K=VolumeofDisk}" />

                <coreUI:AZ IsA="{Binding SelectedDiskItem.VolumeItems.IsEmpty}">
                    <coreUI:AZ.A>
                        <coreUI:IconTextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Icon="&#xEDA2;"
                            Text="{core:SRE K=NoVolumesFound}" />
                    </coreUI:AZ.A>
                    <coreUI:AZ.B>
                        <ListView ItemsSource="{Binding SelectedDiskItem.VolumeItems}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="5,10"
                                        ColumnDefinitions="50,*,Auto"
                                        CornerRadius="5">
                                        <Grid
                                            Height="50"
                                            Padding="5"
                                            Background="{ThemeResource Foreground2}"
                                            CornerRadius="5">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}" />
                                        </Grid>

                                        <Grid
                                            Grid.Column="1"
                                            Padding="10"
                                            RowDefinitions="Auto,Auto,Auto">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock FontSize="12" Text="{Binding VolumeName}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Top"
                                                    FontSize="12"
                                                    Text="{Binding FileSystem}" />
                                            </Grid>

                                            <StackPanel
                                                Grid.Row="1"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource Foreground2}">
                                                    <Run Text="{core:SRE K=Used}" />
                                                    <Run Text=": " />
                                                    <Run Text="{Binding UsedSize, Converter={StaticResource FileSizeToStringConverter}}" />
                                                    <Run Text="/ " />
                                                    <Run Text="{Binding Size, Converter={StaticResource FileSizeToStringConverter}}" />
                                                </TextBlock>
                                                <ProgressBar Maximum="{Binding Size}" Value="{Binding UsedSize}">
                                                    <ProgressBar.RenderTransform>
                                                        <ScaleTransform ScaleY="2" />
                                                    </ProgressBar.RenderTransform>
                                                </ProgressBar>
                                            </StackPanel>
                                        </Grid>

                                        <Grid
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            RowDefinitions="Auto,Auto"
                                            RowSpacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <coreUI:IconButton
                                                    Grid.Column="1"
                                                    DataContext="{Binding}"
                                                    Flyout="{StaticResource VolumeMenuFlyout}"
                                                    Icon="&#xE712;"
                                                    Variant="Text" />
                                            </Grid>
                                            <features:FileBadge Grid.Row="2" DataContext="{Binding}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </coreUI:AZ.B>
                </coreUI:AZ>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="10">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{core:SRE K=QuickActions}" />

                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                    <appUI:VIconTextButton
                        Command="{Binding ShowCleanUSBDialogCommand}"
                        Icon="&#xEA99;"
                        IsEnabled="{Binding DiskItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                        Text="{core:SRE K=Clean}" />

                    <appUI:VIconTextButton
                        Grid.Column="1"
                        Command="{Binding ShowCopyFromPcToVolumeCommand}"
                        Icon="&#xF413;"
                        IsEnabled="{Binding DiskItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                        Text="{core:SRE K=CopyPCToUSBs}"
                        ToolTipService.ToolTip="{core:SRE K=CopyPCToUSBs}" />

                    <appUI:VIconTextButton
                        Grid.Column="2"
                        Command="{Binding ShowCopyFromVolumeToPcCommand}"
                        Icon="&#xF413;"
                        IsEnabled="{Binding DiskItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                        Text="{core:SRE K=CopyUSBsToPC}"
                        ToolTipService.ToolTip="{core:SRE K=CopyUSBsToPC}" />

                    <coreUI:AZ Grid.Column="3" IsA="{Binding SelectedDiskItem.IsSecured, Converter={StaticResource InvertedBoolConverter}}">
                        <coreUI:AZ.A>
                            <appUI:VIconTextButton
                                Command="{Binding ShowSecureVolumeCommand}"
                                Icon="&#xE72E;"
                                IsEnabled="{Binding DiskItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                                Text="{core:SRE K=Secure}" />
                        </coreUI:AZ.A>
                        <coreUI:AZ.B>
                            <appUI:VIconTextButton
                                Command="{Binding ShowSecureVolumeCommand}"
                                Icon="&#xE785;"
                                IsEnabled="{Binding DiskItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                                Text="{core:SRE K=Unsecure}" />
                        </coreUI:AZ.B>
                    </coreUI:AZ>

                    <appUI:VIconTextButton
                        Grid.Column="4"
                        Command="{Binding Window.ShowPremiumDialogCommand}"
                        Icon="&#xE734;"
                        IsTheme="True"
                        Text="{core:SRE K=Premium}"
                        Visibility="{Binding Window.License.Status.IsTrial}" />
                </Grid>
            </StackPanel>

            <features:TrialInfoButton
                Grid.Row="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</apps:MainWindowPage>



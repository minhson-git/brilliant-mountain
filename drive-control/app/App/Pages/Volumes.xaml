<?xml version="1.0" encoding="utf-8" ?>
<apps:MainWindowPage
    x:Class="IOApp.Pages.Volumes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appUI="using:IOApp.UI"
    xmlns:apps="using:IOApp"
    xmlns:core="using:IOCore"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:IOApp.Pages"
    d:DataContext="{d:DesignInstance Type=pages:Volumes}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <apps:MainWindowPage.Resources>
        <pages:VolumesProxy x:Name="Proxy" Data="{Binding}" />
    </apps:MainWindowPage.Resources>

    <Grid ColumnDefinitions="360,*">
        <coreUI:AZ IsA="{Binding VolumeItems.IsEmpty}">
            <coreUI:AZ.A>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="80"
                        Glyph="&#xEDA2;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{core:SRE K=InsertDriveMessage}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </coreUI:AZ.A>
            <coreUI:AZ.B>
                <Grid
                    Padding="5"
                    RowDefinitions="Auto,*"
                    RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{core:SRE K=Volumes}" />
                            <Run Text=" : " />
                            <Run Text="{Binding VolumeItems.Count}" />
                        </TextBlock>

                        <coreUI:IconButton
                            Grid.Column="2"
                            Flyout="{Binding SecureFilterMenuFlyout}"
                            Icon="{Binding SecureFilterIcon}"
                            Variant="Text" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        IsEnabled="{Binding Status.IsNotLoading}"
                        ItemsSource="{Binding VolumeItems}"
                        SelectedItem="{Binding SelectedVolumeItem, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="0,10"
                                    ColumnDefinitions="50,*,Auto"
                                    ColumnSpacing="10"
                                    CornerRadius="5">
                                    <Grid
                                        Height="50"
                                        Background="{ThemeResource Foreground2}"
                                        CornerRadius="3">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}" />
                                    </Grid>

                                    <Grid Grid.Column="1" RowDefinitions="*,Auto">
                                        <TextBlock FontSize="12" Text="{Binding VolumeName}" />

                                        <StackPanel Grid.Row="1">
                                            <TextBlock FontSize="12">
                                                <Run Text="{core:SRE K=Free}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding FreeSpace, Converter={StaticResource FileSizeToStringConverter}}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding Size, Converter={StaticResource FileSizeToStringConverter}}" />
                                            </TextBlock>

                                            <TextBlock
                                                FontSize="12"
                                                FontStyle="Italic"
                                                Foreground="{ThemeResource Foreground2}">
                                                <Run Text="{core:SRE K=Used}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding UsedSize, Converter={StaticResource FileSizeToStringConverter}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="10"
                                            Text="{Binding FileSystem}" />

                                        <features:FileBadge Grid.Row="2" DataContext="{Binding}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </coreUI:AZ.B>
        </coreUI:AZ>

        <Grid
            Grid.Column="1"
            Padding="10"
            Background="{ThemeResource DockBackground}"
            CornerRadius="5"
            RowDefinitions="*,Auto,Auto,Auto"
            RowSpacing="10">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{core:SRE K=Detail}" />

                <coreUI:AZ IsA="{Binding SelectedVolumeItem, Converter={StaticResource IsNullConverter}}">
                    <coreUI:AZ.A>
                        <coreUI:IconTextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Icon="&#xEDA2;"
                            Text="{core:SRE K=NoInformationFound}" />
                    </coreUI:AZ.A>
                    <coreUI:AZ.B>
                        <StackPanel
                            Padding="5"
                            Background="{ThemeResource DockBackground}"
                            CornerRadius="5"
                            Spacing="10">
                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,*,*">
                                    <TextBlock Foreground="{ThemeResource Foreground2}" Text="{core:SRE K=VolumeName}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource Foreground2}"
                                        Text="{core:SRE K=FileSystem}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource Foreground2}"
                                        Text="{core:SRE K=Serial}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*">
                                    <TextBlock FontWeight="Bold" Text="{Binding SelectedVolumeItem.VolumeName}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedVolumeItem.FileSystem}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedVolumeItem.SerialNumber}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="2*,*">
                                    <TextBlock Foreground="{ThemeResource Foreground2}" Text="{core:SRE K=DiskCaption}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource Foreground2}"
                                        Text="{core:SRE K=Secure}" />
                                </Grid>

                                <Grid ColumnDefinitions="2*,*">
                                    <TextBlock FontWeight="Bold" Text="{Binding SelectedVolumeItem.DiskCaption}" />

                                    <features:FileBadge Grid.Column="2" DataContext="{Binding SelectedVolumeItem}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,*,*">
                                    <TextBlock Foreground="{ThemeResource Foreground2}" Text="{core:SRE K=TotalCapacity}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource Foreground2}"
                                        Text="{core:SRE K=Used}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource Foreground2}"
                                        Text="{core:SRE K=Free}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*">
                                    <TextBlock FontWeight="Bold" Text="{Binding SelectedVolumeItem.Size, Converter={StaticResource FileSizeToStringConverter}}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedVolumeItem.UsedSize, Converter={StaticResource FileSizeToStringConverter}}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedVolumeItem.FreeSpace, Converter={StaticResource FileSizeToStringConverter}}" />
                                </Grid>
                            </StackPanel>

                            <Grid Height="10">
                                <ProgressBar
                                    VerticalAlignment="Top"
                                    Maximum="{Binding SelectedVolumeItem.Size}"
                                    Value="{Binding SelectedVolumeItem.UsedSize}">
                                    <ProgressBar.RenderTransform>
                                        <ScaleTransform ScaleY="3" />
                                    </ProgressBar.RenderTransform>
                                </ProgressBar>
                            </Grid>
                        </StackPanel>
                    </coreUI:AZ.B>
                </coreUI:AZ>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="10">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{core:SRE K=QuickActions}" />

                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                    <appUI:VIconTextButton
                        Command="{Binding ShowVolumeSettingsCommand}"
                        Icon="&#xE70F;"
                        IsEnabled="{Binding SelectedVolumeItem, Converter={StaticResource InvertedIsNullConverter}}"
                        Text="{core:SRE K=Rename}" />

                    <appUI:VIconTextButton
                        Grid.Column="1"
                        Command="{Binding ShowVolumeSettingsCommand}"
                        Icon="&#xEDA2;"
                        IsEnabled="{Binding SelectedVolumeItem, Converter={StaticResource InvertedIsNullConverter}}"
                        Text="{core:SRE K=Format}" />

                    <appUI:VIconTextButton
                        Grid.Column="2"
                        Command="{Binding ShowSyncVolumeCommand}"
                        Icon="&#xE895;"
                        IsEnabled="{Binding SelectedVolumeItem, Converter={StaticResource InvertedIsNullConverter}}"
                        Text="{core:SRE K=Sync}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="10">
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                    <appUI:VIconTextButton
                        Command="{Binding ShowCleanVolumeCommand}"
                        Icon="&#xEA99;"
                        IsEnabled="{Binding VolumeItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                        Text="{core:SRE K=Clean}" />

                    <appUI:VIconTextButton
                        Grid.Column="1"
                        Command="{Binding ShowCopyFromPcToVolumeCommand}"
                        Icon="&#xF413;"
                        IsEnabled="{Binding VolumeItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                        Text="{core:SRE K=CopyPCToUSBs}"
                        ToolTipService.ToolTip="{core:SRE K=CopyPCToUSBs}" />

                    <appUI:VIconTextButton
                        Grid.Column="2"
                        Command="{Binding ShowCopyFromVolumeToPcCommand}"
                        Icon="&#xF413;"
                        IsEnabled="{Binding VolumeItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                        Text="{core:SRE K=CopyUSBsToPC}"
                        ToolTipService.ToolTip="{core:SRE K=CopyUSBsToPC}" />

                    <coreUI:AZ Grid.Column="3" IsA="{Binding SelectedVolumeItem.SecureType, ConverterParameter=Unsecured, Converter={StaticResource IsEqualEnumsConverter}}">
                        <coreUI:AZ.A>
                            <appUI:VIconTextButton
                                Command="{Binding ShowSecureVolumeCommand}"
                                Icon="&#xE72E;"
                                IsEnabled="{Binding VolumeItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                                Text="{core:SRE K=Secure}" />
                        </coreUI:AZ.A>
                        <coreUI:AZ.B>
                            <appUI:VIconTextButton
                                Command="{Binding ShowSecureVolumeCommand}"
                                Icon="&#xE785;"
                                IsEnabled="{Binding VolumeItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}"
                                Text="{core:SRE K=Unsecure}" />
                        </coreUI:AZ.B>
                    </coreUI:AZ>

                    <appUI:VIconTextButton
                        Grid.Column="4"
                        Command="{Binding Window.ShowPremiumDialogCommand}"
                        Icon="&#xE734;"
                        IsTheme="True"
                        Text="{core:SRE K=Premium}"
                        Visibility="{Binding Window.License.Status.IsTrial}" />
                </Grid>
            </StackPanel>

            <features:TrialInfoButton
                Grid.Row="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</apps:MainWindowPage>
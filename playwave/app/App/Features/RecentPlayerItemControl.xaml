<?xml version="1.0" encoding="utf-8" ?>
<af:PlayerItemGrid
    x:Class="IOApp.Features.RecentPlayerItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:af="using:IOApp.Features"
    xmlns:cui="using:IOCore.UI"
    xmlns:cuib="using:IOCore.UI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ColumnDefinitions="*,Auto"
    mc:Ignorable="d">

    <Grid
        Padding="10,5"
        cuib:Tap.IsEnabled="True"
        cuib:Tap.LCommand="{x:Bind LTapCommand}"
        cuib:Tap.LDoubleCommand="{x:Bind LDoubleTapCommand}"
        Background="Transparent"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="10">
        <Grid
            Width="28"
            Height="32"
            CornerRadius="5">

            <cui:AZ IsA="{x:Bind Item.InputInfo.IsCorrupted, Mode=OneWay}" IsB="{x:Bind Item.InputInfo.HasVideo, Mode=OneWay}">
                <cui:AZ.A>
                    <FontIcon
                        FontSize="18"
                        Foreground="{ThemeResource Foreground2}"
                        Glyph="&#xE814;"
                        Visibility="{x:Bind Item.InputInfo.IsCorrupted, Mode=OneWay, Converter={StaticResource Bool}}" />
                </cui:AZ.A>
                <cui:AZ.B>
                    <Image
                        Width="28"
                        Height="28"
                        Source="{x:Bind Item.Thumbnail.ImagePath, Mode=OneWay, Converter={StaticResource PathToResource}}"
                        Stretch="UniformToFill" />
                </cui:AZ.B>
                <cui:AZ.C>
                    <FontIcon
                        FontSize="18"
                        Foreground="{ThemeResource Foreground2}"
                        Glyph="&#xE8D6;" />
                </cui:AZ.C>
            </cui:AZ>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                FontSize="14"
                Text="{x:Bind Item.InputInfo.Name, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Item.InputInfo.Name, Mode=OneWay}" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Visibility="{x:Bind Item.InputInfo.IsCorrupted, Mode=OneWay, Converter={StaticResource InvertedBool}}">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource Foreground2}"
                    Text="{x:Bind Item.InputInfo.FileSize, Mode=OneWay, Converter={StaticResource FileSizeToText}}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource Foreground2}"
                    Text="{x:Bind Item.InputInfo.Duration, Mode=OneWay, Converter={StaticResource ToTimeText}}" />
            </StackPanel>
        </StackPanel>
    </Grid>

    <StackPanel
        Grid.Column="1"
        Margin="10,0"
        Orientation="Horizontal"
        Spacing="5"
        Visibility="{x:Bind UseMoreButton, Mode=OneWay, Converter={StaticResource Bool}}">
        <cui:AZ IsA="{x:Bind Item.InputInfo.IsCorrupted, Mode=OneWay}" Visibility="{x:Bind UsePlayFeature, Mode=OneWay, Converter={StaticResource Bool}}">
            <cui:AZ.A>
                <Border />
            </cui:AZ.A>
            <cui:AZ.B>
                <cui:ABIconButton
                    VerticalAlignment="Center"
                    CheckedIcon="&#xE769;"
                    Command="{x:Bind PreviewCommand}"
                    Icon="&#xE768;"
                    IsChecked="{x:Bind Item.IsPlaying, Mode=OneWay}"
                    IsEnabled="{x:Bind Item.Status.IsNotLoading, Mode=OneWay}"
                    Size="SM"
                    Variant="Text" />
            </cui:AZ.B>
        </cui:AZ>

        <cui:IconButton
            Command="{x:Bind ShowMenuCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
            Icon="&#xe712;"
            IsEnabled="{x:Bind Item.Status.IsNotLoading, Mode=OneWay}"
            Size="SM"
            Variant="Text" />
    </StackPanel>
</af:PlayerItemGrid>
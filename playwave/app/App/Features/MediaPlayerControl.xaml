<?xml version="1.0" encoding="utf-8" ?>
<Grid
    x:Class="IOApp.Features.MediaPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cme="using:IOCore.MarkupExtensions"
    xmlns:cui="using:IOCore.UI"
    xmlns:cuib="using:IOCore.UI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mmpb="using:XMedia.Media.PlayerBase"
    Height="60"
    Padding="5,0"
    Background="#11ffffff"
    ColumnDefinitions="*,Auto"
    ColumnSpacing="5"
    Visibility="{x:Bind mmpb:PlayerEx.I.Player.CanPlay, Mode=OneWay, Converter={StaticResource Bool}}"
    mc:Ignorable="d">

    <Grid
        cuib:Tap.IsEnabled="True"
        cuib:Tap.LCommand="{x:Bind GoToMediaPlayerCommand}"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="5">
        <Grid
            Width="32"
            Height="32"
            CornerRadius="5">
            <cui:AZ IsA="{x:Bind mmpb:PlayerEx.I.Current.InputInfo.IsCorrupted, Mode=OneWay}" IsB="{x:Bind mmpb:PlayerEx.I.Current.InputInfo.HasVideo, Mode=OneWay}">
                <cui:AZ.A>
                    <FontIcon
                        FontSize="24"
                        Foreground="{ThemeResource Foreground2}"
                        Glyph="&#xE814;"
                        Visibility="{x:Bind mmpb:PlayerEx.I.Current.InputInfo.IsCorrupted, Mode=OneWay, Converter={StaticResource Bool}}" />
                </cui:AZ.A>
                <cui:AZ.B>
                    <Image
                        Width="32"
                        Height="32"
                        Source="{x:Bind mmpb:PlayerEx.I.Current.Thumbnail.ImagePath, Mode=OneWay, Converter={StaticResource PathToResource}}"
                        Stretch="UniformToFill" />
                </cui:AZ.B>
                <cui:AZ.C>
                    <cui:RotatedImage
                        IsPlaying="{x:Bind mmpb:PlayerEx.I.Current.IsPlaying, Mode=OneWay}"
                        Path="{cme:StaticPath Name=disk.svg}"
                        Size="32" />
                </cui:AZ.C>
            </cui:AZ>
        </Grid>

        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="12"
            MaxLines="2"
            Text="{x:Bind mmpb:PlayerEx.I.Current.InputInfo.Name, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />
    </Grid>

    <cui:ABIconButton
        Grid.Column="1"
        VerticalAlignment="Center"
        Background="Transparent"
        CheckedIcon="&#xE769;"
        Command="{x:Bind mmpb:PlayerEx.I.Player.Commands.TogglePlayPause}"
        Icon="&#xE768;"
        IsChecked="{x:Bind mmpb:PlayerEx.I.Current.IsPlaying, Mode=OneWay}"
        IsEnabled="{x:Bind mmpb:PlayerEx.I.Player.CanPlay, Mode=OneWay}"
        Variant="Text" />

    <Slider
        Grid.ColumnSpan="2"
        Margin="0,0,0,-15"
        VerticalAlignment="Bottom"
        IsEnabled="{x:Bind mmpb:PlayerEx.I.Player.CanPlay, Mode=OneWay}"
        IsThumbToolTipEnabled="False"
        Loaded="TimeSlider_FirstLoaded"
        Maximum="{x:Bind mmpb:PlayerEx.I.Player.Duration, Mode=OneWay, Converter={StaticResource ToTimeTotalSeconds}}"
        Value="{x:Bind mmpb:PlayerEx.I.Player.CurTime, Mode=OneWay, Converter={StaticResource ToTimeTotalSeconds}}" />
</Grid>
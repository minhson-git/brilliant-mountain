<?xml version="1.0" encoding="utf-8" ?>
<c:WindowEx
    x:Class="IOApp.Windows.PremiumWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ag="using:IOApp.Gens"
    xmlns:ap="using:IOApp.Pages"
    xmlns:c="using:IOCore"
    xmlns:cme="using:IOCore.MarkupExtensions"
    xmlns:cp="using:IOCore.Premium"
    xmlns:cui="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wam="using:Windows.ApplicationModel"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource WindowBackground}">
        <Grid RowDefinitions="Auto,*">
            <cui:TitleBarEx
                Name="_tb"
                Height="48"
                IsSubtitleVisible="False">
                <cui:TitleBarEx.Content>
                    <StackPanel
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#fff">
                            <Run Text="{x:Bind wam:AppInfo.Current.DisplayInfo.DisplayName}" />
                        </TextBlock>
                        <TextBlock
                            FontSize="18"
                            Foreground="#fff"
                            Opacity="0.8"
                            TextWrapping="WrapWholeWords">
                            <Run Text="{ag:SR K=Premium_PurchasePremiumIntro}" />
                            <Run Text="{x:Bind wam:AppInfo.Current.DisplayInfo.DisplayName}" />
                            <Run Text="{x:Bind cp:PremiumCore.I.ConceptText}" />
                        </TextBlock>
                    </StackPanel>
                </cui:TitleBarEx.Content>
            </cui:TitleBarEx>
            <cui:NavigationViewEx
                Name="_nv"
                Grid.Row="1"
                BorderThickness="0"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsPaneVisible="False"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="True"
                PaneDisplayMode="Top">
                <cui:NavigationViewEx.MenuItems>
                    <cui:NavigationViewItemEx PageType="{cme:X T=ap:Premium}" />
                </cui:NavigationViewEx.MenuItems>
                <Frame Name="_f" />
            </cui:NavigationViewEx>
        </Grid>
    </Grid>
</c:WindowEx>
<?xml version="1.0" encoding="utf-8" ?>
<ap:HomePage
    x:Class="IOApp.Pages.Folder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:af="using:IOApp.Features"
    xmlns:ag="using:IOApp.Gens"
    xmlns:ap="using:IOApp.Pages"
    xmlns:cui="using:IOCore.UI"
    xmlns:cuib="using:IOCore.UI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <ap:HomePage.Resources>
        <ap:FolderProxy x:Name="Proxy" _="{x:Bind}" />
    </ap:HomePage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
            <ItemsRepeater
                ItemsSource="{x:Bind FolderCheckList.ViewItems}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="af:FolderCheckableItem">
                        <Grid
                            Width="120"
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="5"
                            CornerRadius="5"
                            ToolTipService.ToolTip="{x:Bind Source.Path, Mode=OneWay}">
                            <TextBlock VerticalAlignment="Center">
                                <Run FontSize="12" Text="{x:Bind Source.Path, Mode=OneWay, ConverterParameter=FileName, Converter={StaticResource Path}}" />
                                <LineBreak />
                                <Run
                                    FontSize="8"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{x:Bind Source.Path, Mode=OneWay, ConverterParameter=DirectoryName, Converter={StaticResource Path}}" />
                            </TextBlock>
                            <cui:ABIconButton
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                CheckedIcon="&#xe73d;"
                                Corner="None"
                                Icon="&#xe739;"
                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                IsEnabled="{Binding _.Status.IsNotLoading, Source={StaticResource Proxy}}"
                                Mode="Toggle"
                                Size="SM"
                                Variant="Text" />
                            <cui:IconButton
                                Grid.Column="2"
                                Command="{Binding _.RemoveFolderCommand, Source={StaticResource Proxy}}"
                                CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                Icon="&#xE894;"
                                IsEnabled="{Binding _.Status.IsNotLoading, Source={StaticResource Proxy}}"
                                Size="SM"
                                Variant="Text" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <CheckBox
                Grid.Column="1"
                MinWidth="32"
                Content=""
                IsChecked="{x:Bind FolderCheckList.IsChecked, Mode=TwoWay}"
                IsEnabled="{x:Bind Status.IsNotLoading, Mode=OneWay}" />
            <cui:IconButton
                Grid.Column="2"
                Command="{x:Bind AddFolderCommand}"
                Icon="&#xe710;"
                IsEnabled="{x:Bind Status.IsNotLoading, Mode=OneWay}"
                Variant="Text" />
        </Grid>

        <Grid Grid.Row="1">
            <cui:AZ IsA="{x:Bind FolderCheckList.IsEmpty, Mode=OneWay}">
                <cui:AZ.A>
                    <Button
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Command="{x:Bind AddFolderCommand}"
                        CornerRadius="10"
                        IsEnabled="{x:Bind Status.IsNotLoading, Mode=OneWay}">
                        <StackPanel VerticalAlignment="Center" Spacing="5">
                            <Grid
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="48"
                                    Glyph="&#xE8F4;" />
                            </Grid>
                            <TextBlock HorizontalAlignment="Stretch" HorizontalTextAlignment="Center">
                                <Run Text="{ag:SR K=AddVideoFolderOrMusicFolder}" />
                                <LineBreak />
                                <Run
                                    FontSize="12"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{ag:SR K=OrDragAndDrop}" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </cui:AZ.A>
                <cui:AZ.B>
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{x:Bind RefinedPlayerItems.Count, Mode=OneWay, Converter={StaticResource ItemCounter}}" />
                                <cui:IconButton
                                    VerticalAlignment="Center"
                                    cuib:Enable.Value1="{x:Bind Status.IsNotLoading, Mode=OneWay}"
                                    cuib:Enable.Value2="{x:Bind RefinedPlayerItems.IsNotEmpty, Mode=OneWay}"
                                    Command="{x:Bind PlayAllCommand}"
                                    Icon="&#xF5B0;"
                                    Size="SM" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            Name="PlayerItemsListView"
                            Grid.Row="1"
                            Padding="0"
                            ContainerContentChanging="PlayerItemsListViewBase_ContainerContentChanging"
                            IsEnabled="{x:Bind Status.IsNotLoading, Mode=OneWay}"
                            ItemsSource="{x:Bind RefinedPlayerItems.ViewItems}"
                            SelectionMode="Extended">
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="af:PlayerItem">
                                    <af:RecentPlayerItemControl Item="{x:Bind}" OnHandle="PlayerItemControl_OnHandle" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </cui:AZ.B>
            </cui:AZ>
        </Grid>
    </Grid>
</ap:HomePage>
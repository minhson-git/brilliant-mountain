<?xml version="1.0" encoding="utf-8" ?>
<aw:MainWindowPage
    x:Class="IOApp.Pages.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:af="using:IOApp.Features"
    xmlns:ag="using:IOApp.Gens"
    xmlns:ap="using:IOApp.Pages"
    xmlns:aw="using:IOApp.Windows"
    xmlns:cl="using:IOCore.License"
    xmlns:cme="using:IOCore.MarkupExtensions"
    xmlns:cp="using:IOCore.Premium"
    xmlns:cui="using:IOCore.UI"
    xmlns:cuib="using:IOCore.UI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid
            Padding="10,0,10,10"
            Background="{ThemeResource Background}"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10"
            Visibility="{x:Bind Window.IsSearchFilterVisible, Mode=OneWay, Converter={StaticResource Bool}}">
            <cui:TextBoxEx
                IsEnabled="{x:Bind Status.IsNotLoading, Mode=OneWay}"
                PlaceholderText="{ag:SR K=Search}"
                PrefixIcon="&#xE71E;"
                Text="{x:Bind SearchTerm, Mode=TwoWay}" />

            <cui:TextBoxEx
                Grid.Column="1"
                IsReadOnly="True"
                Text="{x:Bind SortCheckableMenuFlyout.CheckedItem.OriginalText, Mode=OneWay}">
                <cui:TextBoxEx.ActionButton>
                    <cui:IconTextButton
                        Corner="Right"
                        Flyout="{x:Bind SortCheckableMenuFlyout}"
                        Icon="&#xE8CB;"
                        IsEnabled="{x:Bind Status.IsNotLoading, Mode=OneWay}"
                        IsThemeEnabled="True"
                        Scheme="Theme"
                        Variant="NoBorder" />
                </cui:TextBoxEx.ActionButton>
            </cui:TextBoxEx>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto">
            <Frame Name="_f" Padding="10" />
            <af:MediaPlayerControl x:Name="_mediaPlayerControl" Grid.Row="1" />
        </Grid>

        <cui:NavigationViewEx
            Name="_hnv"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsEnabled="{x:Bind Status.IsNotBusy, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            PaneDisplayMode="Top">
            <cui:NavigationViewEx.MenuItems>
                <cui:NavigationViewItemEx PageType="{cme:X T=ap:Playlist}">
                    <cui:NavigationViewItemEx.Icon>
                        <FontIcon Glyph="&#xe8f1;" />
                    </cui:NavigationViewItemEx.Icon>
                </cui:NavigationViewItemEx>
                <cui:NavigationViewItemEx PageType="{cme:X T=ap:Folder}">
                    <cui:NavigationViewItemEx.Icon>
                        <FontIcon Glyph="&#xe8b7;" />
                    </cui:NavigationViewItemEx.Icon>
                </cui:NavigationViewItemEx>
                <cui:NavigationViewItemEx PageType="{cme:X T=ap:Recent}">
                    <cui:NavigationViewItemEx.Icon>
                        <FontIcon Glyph="&#xe81c;" />
                    </cui:NavigationViewItemEx.Icon>
                </cui:NavigationViewItemEx>
            </cui:NavigationViewEx.MenuItems>

            <cui:NavigationViewEx.PaneFooter>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <cui:IconTextButton
                        Command="{x:Bind Window.ShowPremiumWindowCommand}"
                        IsThemeEnabled="True"
                        Scheme="Theme"
                        Size="SM"
                        Text="{x:Bind cp:PremiumCore.I.ConceptText}"
                        Visibility="{x:Bind cl:IOLicense.I.Status.IsTrial, Mode=OneWay, Converter={StaticResource Bool}}" />
                    <cui:IconButton
                        cuib:Menu.IsMenuProvider="True"
                        Icon="&#xE713;"
                        Variant="Text" />
                </StackPanel>
            </cui:NavigationViewEx.PaneFooter>
        </cui:NavigationViewEx>
    </Grid>
</aw:MainWindowPage>
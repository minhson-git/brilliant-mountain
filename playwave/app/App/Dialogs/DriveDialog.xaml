<?xml version="1.0" encoding="utf-8" ?>
<cd:DialogEx
    x:Class="IOApp.Dialogs.DriveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ad="using:IOApp.Dialogs"
    xmlns:af="using:IOApp.Features"
    xmlns:ag="using:IOApp.Gens"
    xmlns:cd="using:IOCore.Dialogs"
    xmlns:cui="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <cd:DialogEx.Resources>
        <ad:DriveDialogProxy x:Name="Proxy" _="{x:Bind}" />
    </cd:DialogEx.Resources>

    <cui:StandardLayout Title="{x:Bind DriveItem.Text, Mode=OneWay}">
        <cui:StandardLayout.Panel>
            <Grid>
                <cui:EmptyList
                    Icon="{x:Bind DriveItem.Icon, Mode=OneWay}"
                    Text="{ag:SR K=NothingInList}"
                    Visibility="{x:Bind PlayerItems.IsEmpty, Mode=OneWay, Converter={StaticResource Bool}}" />

                <ScrollView
                    Width="500"
                    MaxHeight="500"
                    Visibility="{x:Bind PlayerItems.IsNotEmpty, Mode=OneWay, Converter={StaticResource Bool}}">
                    <ItemsRepeater ItemsSource="{x:Bind PlayerItems}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="1" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="af:PlayerItem">
                                <Grid
                                    Padding="15,5"
                                    Background="{ThemeResource Foreground_0_1}"
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="15">
                                    <Border
                                        Width="48"
                                        Height="48"
                                        CornerRadius="5">
                                        <cui:AZ IsA="{x:Bind InputInfo.HasVideo, Mode=OneWay}">
                                            <cui:AZ.A>
                                                <Image
                                                    Width="48"
                                                    Height="48"
                                                    Source="{x:Bind Thumbnail.ImagePath, Mode=OneWay, Converter={StaticResource PathToResource}}"
                                                    Stretch="UniformToFill" />
                                            </cui:AZ.A>
                                            <cui:AZ.B>
                                                <FontIcon
                                                    FontSize="32"
                                                    Foreground="{ThemeResource Foreground2}"
                                                    Glyph="&#xE8D6;" />
                                            </cui:AZ.B>
                                        </cui:AZ>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind InputInfo.Name, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource Foreground2}"
                                                Text="{x:Bind InputInfo.FileSize, Mode=OneWay, Converter={StaticResource FileSizeToText}}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource Foreground2}"
                                                Text="{x:Bind InputInfo.Duration, Mode=OneWay, Converter={StaticResource ToTimeText}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <cui:ABIconButton
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        CheckedIcon="&#xE768;"
                                        Command="{Binding _.PlayCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{x:Bind}"
                                        Icon="&#xE769;"
                                        IsChecked="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource InvertedBool}}"
                                        Variant="Text" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollView>
            </Grid>
        </cui:StandardLayout.Panel>
    </cui:StandardLayout>
</cd:DialogEx>
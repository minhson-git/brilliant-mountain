<?xml version="1.0" encoding="utf-8" ?>
<core:WindowEx
    x:Class="IOApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:apps="using:IOApp"
    xmlns:core="using:IOCore"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:IOApp.Pages"
    mc:Ignorable="d">
    <Grid d:DataContext="{d:DesignInstance Type=apps:MainWindow}">
        <Grid RowDefinitions="Auto,*">
            <coreUI:TitleBarEx
                Name="TitleBar"
                x:FieldModifier="Public"
                IsSubtitleVisible="False">

                <coreUI:TitleBarEx.RightHeader>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <coreUI:IconButton
                            Command="{Binding Menu.ShowMenuCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Icon="&#xE713;"
                            IsArcCorner="True"
                            Variant="Text" />
                    </StackPanel>
                </coreUI:TitleBarEx.RightHeader>
            </coreUI:TitleBarEx>

            <coreUI:NavigationViewEx
                Name="NavigationView"
                Grid.Row="1"
                x:FieldModifier="Public"
                IsPaneVisible="False">
                <coreUI:NavigationViewEx.MenuItems>
                    <coreUI:NavigationViewItemEx PageType="{core:X T=pages:Home}" />
                </coreUI:NavigationViewEx.MenuItems>
                <Frame Name="_frame" />
            </coreUI:NavigationViewEx>
        </Grid>
    </Grid>
</core:WindowEx>
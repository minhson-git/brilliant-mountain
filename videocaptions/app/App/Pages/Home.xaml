<?xml version="1.0" encoding="utf-8" ?>
<tubePages:DownloaderPage
    x:Class="IOApp.Pages.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:IOCore"
    xmlns:coreHelpers="using:IOCore.Helpers"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:features="using:IOApp.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:IOApp.Pages"
    xmlns:tubePages="using:IOMedia.Tube.TubeBase"
    d:DataContext="{d:DesignInstance Type=pages:Home}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <coreUI:TextBoxComp
            Width="540"
            Margin="0,24,0,0"
            VerticalAlignment="Center"
            KeyDown="UrlTextBoxComp_KeyDown"
            PlaceholderText="{core:SRE K=PasteVideoLink}"
            PrefixIcon="&#xE774;"
            Size="LG"
            Text="{Binding UrlText, Mode=TwoWay}">
            <coreUI:TextBoxComp.PostfixButton>
                <coreUI:IconButton Command="{Binding PasteCommand}" Icon="&#xE77F;" />
            </coreUI:TextBoxComp.PostfixButton>
            <coreUI:TextBoxComp.ActionButton>
                <coreUI:IconButton
                    Name="ScanIconButton"
                    Command="{Binding ScanCommand}"
                    Icon="&#xF78B;"
                    IsTheme="True" />
            </coreUI:TextBoxComp.ActionButton>
        </coreUI:TextBoxComp>

        <coreUI:AZ
            Grid.Row="1"
            Padding="20"
            IsA="{Binding PreviewedMediaItem, Converter={StaticResource IsNullConverter}}">
            <coreUI:AZ.A>
                <Grid
                    BorderBrush="{ThemeResource Border}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <coreUI:EmptyList
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Icon="&#xEB1D;"
                        Text="{core:SRE K=AddLink}" />
                </Grid>
            </coreUI:AZ.A>
            <coreUI:AZ.B>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!--  PreviewedMediaItem  -->
                    <Grid
                        Padding="12"
                        BorderBrush="{ThemeResource Border}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <features:MediaThumbnail ThumbnailPath="{Binding PreviewedMediaItem.ThumbnailUrl}" Duration="{Binding PreviewedMediaItem.Duration}" />

                            <HyperlinkButton
                                Padding="0"
                                HorizontalAlignment="Center"
                                NavigateUri="{Binding PreviewedMediaItem.Url}">
                                <TextBlock
                                    FontSize="18"
                                    MaxLines="3"
                                    Text="{Binding PreviewedMediaItem.Title}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </HyperlinkButton>
                        </StackPanel>
                    </Grid>

                    <Grid
                        Grid.Column="2"
                        RowDefinitions="Auto,*,Auto,Auto"
                        RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock VerticalAlignment="Center" Text="{core:SRE K=Language}" />

                            <coreUI:ComboBoxEx
                                Grid.Column="2"
                                Width="200"
                                HorizontalAlignment="Center"
                                DisplayMemberPath="Value"
                                ItemsSource="{Binding CaptionLanguageItems}"
                                SelectedIndex="{Binding CaptionLanguageIndex, Mode=TwoWay}"
                                Size="LG"
                                Visibility="{Binding CaptionLanguageItems.Count, ConverterParameter=0, Converter={StaticResource GreaterThanComparisonConverter}}">
                                <coreUI:ComboBoxEx.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="coreHelpers:BindingHelper.IsEnabled" Value="IsEnabled" />
                                    </Style>
                                </coreUI:ComboBoxEx.ItemContainerStyle>
                            </coreUI:ComboBoxEx>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            BorderBrush="{ThemeResource Border}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <TextBox
                                Name="CaptionYoutubeTextBox"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                TextWrapping="Wrap" />
                        </Grid>

                        <coreUI:TextBoxComp
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            PrefixIcon="&#xE838;"
                            Size="LG"
                            Text="{Binding TubeData.OutputPath}">
                            <coreUI:TextBoxComp.TextBoxStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="IsReadOnly" Value="True" />
                                </Style>
                            </coreUI:TextBoxComp.TextBoxStyle>
                            <coreUI:TextBoxComp.ActionButton>
                                <coreUI:IconButton Command="{Binding UpdateOutputPathCommand}" Icon="&#xE8DA;" />
                            </coreUI:TextBoxComp.ActionButton>
                        </coreUI:TextBoxComp>

                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                            <coreUI:IconTextButton
                                Command="{Binding Window.RevealInFileExplorerCommand}"
                                CommandParameter="{Binding OutputInfo.FullName}"
                                Icon="&#xE8DA;"
                                Text="{core:SRE K=RevealInFileExplorer}"
                                Variant="Text"
                                Visibility="{Binding OutputInfo.Exists}" />

                            <coreUI:IconTextButton
                                Grid.Column="2"
                                Width="200"
                                Command="{Binding SaveCommand}"
                                Icon="&#xE74E;"
                                IsTheme="True"
                                Text="{core:SRE K=Save}" />
                        </Grid>
                    </Grid>
                </Grid>
            </coreUI:AZ.B>
        </coreUI:AZ>
    </Grid>
</tubePages:DownloaderPage>
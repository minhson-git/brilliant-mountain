<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreHelpers="using:IOCore.Helpers"
    xmlns:coreLibs="using:IOCore.Libs">
    <Color x:Key="ThemeColor">#40FFA7</Color>
    <Color x:Key="ThemeSecondaryColor">#050761</Color>

    <SolidColorBrush x:Key="Theme" Color="{StaticResource ThemeColor}" />
    <SolidColorBrush x:Key="ThemeSecondary" Color="{StaticResource ThemeSecondaryColor}" />

    <SolidColorBrush x:Key="ThemeLighter" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, BrightnessFactor=0.1}" />
    <SolidColorBrush x:Key="ThemeDarker" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, BrightnessFactor=-0.1}" />
    <SolidColorBrush x:Key="ThemeDarkest" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, BrightnessFactor=-0.9}" />


    <SolidColorBrush
        x:Key="ThemeOpacity"
        Opacity="0.04"
        Color="{StaticResource ThemeColor}" />

    <SolidColorBrush x:Key="ThemeForeground" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, UseContrast=True}" />
    <SolidColorBrush x:Key="ThemeForegroundDisabled" Color="{coreHelpers:ColorAdjustment Color={StaticResource ThemeColor}, UseContrast=True}" />

    <!--    -->

    <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="White" />
    <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="White" />

    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{coreHelpers:ColorAdjustment Color=White, Opacity=0.4}" />
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{coreHelpers:ColorAdjustment Color=White, Opacity=0.4}" />

    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="Black" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundUnchecked" Color="White" />

    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{coreHelpers:ColorAdjustment Color=Black, Opacity=0.4}" />

    <!--    -->

    <coreLibs:ValueConverterGroup x:Key="ProcessingToSelectionModeConverter">
        <coreLibs:EnumComparisonToBoolConverter />
        <coreLibs:BoolToObjectConverter>
            <coreLibs:BoolToObjectConverter.TrueValue>
                <ListViewSelectionMode>None</ListViewSelectionMode>
            </coreLibs:BoolToObjectConverter.TrueValue>
            <coreLibs:BoolToObjectConverter.FalseValue>
                <ListViewSelectionMode>Single</ListViewSelectionMode>
            </coreLibs:BoolToObjectConverter.FalseValue>
        </coreLibs:BoolToObjectConverter>
    </coreLibs:ValueConverterGroup>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush
                x:Key="HudBackground"
                Opacity="0.3"
                Color="#000000" />
            <SolidColorBrush
                x:Key="ItemBackground"
                Opacity="0.1"
                Color="#fff" />
            <SolidColorBrush
                x:Key="ItemSelectedBackground"
                Opacity="0.2"
                Color="#fff" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush
                x:Key="HudBackground"
                Opacity="0.3"
                Color="#000000" />
            <SolidColorBrush
                x:Key="ItemBackground"
                Opacity="0.1"
                Color="#fff" />
            <SolidColorBrush
                x:Key="ItemSelectedBackground"
                Opacity="0.2"
                Color="#fff" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush
                x:Key="HudBackground"
                Opacity="0.3"
                Color="#ffffff" />
            <SolidColorBrush
                x:Key="ItemBackground"
                Opacity="0.1"
                Color="#000" />
            <SolidColorBrush
                x:Key="ItemSelectedBackground"
                Opacity="0.2"
                Color="#000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
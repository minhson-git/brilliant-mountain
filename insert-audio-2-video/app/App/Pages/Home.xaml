<?xml version="1.0" encoding="utf-8" ?>
<pages:PlayerPage
    x:Class="IOApp.Pages.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreAppManager="using:IOCore.AppManager"
    xmlns:coreHelpers="using:IOCore.Helpers"
    xmlns:coreLibs="using:IOCore.Libs"
    xmlns:coreUI="using:IOCore.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:IOApp.Pages"
    d:DataContext="{d:DesignInstance Type=pages:Home}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <pages:PlayerPage.Resources>
        <pages:HomeProxy x:Name="Proxy" Data="{Binding}" />
    </pages:PlayerPage.Resources>

    <Grid
        Padding="10"
        ColumnDefinitions="*,360"
        ColumnSpacing="10">
        <Grid RowDefinitions="*,120,120" RowSpacing="5">
            <Grid
                Padding="5"
                Background="{ThemeResource WindowBackground}"
                CornerRadius="10"
                Loaded="DragDropVideoGrid_Loaded">
                <coreUI:AZ IsA="{Binding PlayerVideo.Playlist.IsEmpty}">
                    <coreUI:AZ.A>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <coreUI:IconButton
                                Command="{Binding AddFileCommand}"
                                CommandParameter="Video"
                                Icon="&#xE714;"
                                Size="XXXL" />

                            <StackPanel Spacing="5">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{coreHelpers:SRE K=AddVideo}" />

                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{coreHelpers:SRE K=OrDragAndDrop}" />
                            </StackPanel>
                        </StackPanel>
                    </coreUI:AZ.A>
                    <coreUI:AZ.B>
                        <Grid>
                            <ContentPresenter Loaded="PresenterVideo_Loaded" />

                            <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                                <coreUI:IconButton
                                    Command="{Binding AddFileCommand}"
                                    CommandParameter="Video"
                                    Icon="&#xEDAB;"
                                    IsEnabled="{Binding Status.IsNotLoading}"
                                    Variant="Text" />

                                <Border
                                    Height="24"
                                    Padding="10,0"
                                    Background="#55000000"
                                    CornerRadius="10">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#fff"
                                        Text="{Binding PlayerVideo.Current.InputInfo.Name}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </coreUI:AZ.B>
                </coreUI:AZ>
            </Grid>

            <Grid
                Grid.Row="1"
                Padding="5"
                Background="{ThemeResource WindowBackground}"
                CornerRadius="10"
                Loaded="DragDropAudioGrid_Loaded">
                <coreUI:AZ IsA="{Binding PlayerAudio.Playlist.IsEmpty}">
                    <coreUI:AZ.A>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <coreUI:IconButton
                                Command="{Binding AddFileCommand}"
                                CommandParameter="Audio"
                                Icon="&#xE8D6;"
                                Size="XXXL" />

                            <StackPanel Spacing="5">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{coreHelpers:SRE K=AddAudio}" />

                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource Foreground2}"
                                    Text="{coreHelpers:SRE K=OrDragAndDrop}" />
                            </StackPanel>
                        </StackPanel>
                    </coreUI:AZ.A>
                    <coreUI:AZ.B>
                        <Grid>
                            <FontIcon FontSize="64" Glyph="&#xEC4F;" />

                            <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                                <coreUI:IconButton
                                    Command="{Binding AddFileCommand}"
                                    CommandParameter="Audio"
                                    Icon="&#xEDAB;"
                                    IsEnabled="{Binding Status.IsNotLoading}"
                                    Variant="Text" />

                                <Border
                                    Height="24"
                                    Padding="10,0"
                                    Background="#55000000"
                                    CornerRadius="10">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#fff"
                                        Text="{Binding PlayerAudio.Current.InputInfo.Name}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </coreUI:AZ.B>
                </coreUI:AZ>
            </Grid>

            <Grid
                Grid.Row="2"
                Padding="5"
                Background="{ThemeResource WindowBackground}"
                CornerRadius="10">
                <Grid VerticalAlignment="Top" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <coreUI:IconTextButton
                            Command="{Binding OpenDownloadDialogCommand}"
                            CommandParameter="Video"
                            IsTheme="True"
                            Text="{coreHelpers:SRE K=VideoDownloader}" />

                        <coreUI:IconTextButton
                            Command="{Binding OpenDownloadDialogCommand}"
                            CommandParameter="Audio"
                            IsTheme="True"
                            Text="{coreHelpers:SRE K=AudioDownloader}" />
                    </StackPanel>

                    <coreAppManager:PromotionApp
                        Grid.Column="2"
                        DataContext="{Binding PromotionAppItems.FirstOrDefault}"
                        IsLite="True"
                        IsVisible0="{Binding Data.Window.LicenseStatus.IsTrial, Source={StaticResource Proxy}}"
                        IsVisible1="{Binding Data.PromotionAppItems.IsNotEmpty, Source={StaticResource Proxy}}" />
                </Grid>

                <StackPanel VerticalAlignment="Bottom">
                    <Grid Padding="10,0" ColumnDefinitions="70,*,70">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#fff"
                            Text="{Binding PlayerVideo.Player.CurTime, Converter={StaticResource TicksToStringConverter}}" />
                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding PlayerVideo.Player.CanPlay}"
                            IsThumbToolTipEnabled="False"
                            Loaded="TimeSlider_Loaded"
                            Maximum="{Binding PlayerVideo.Player.Duration, Converter={StaticResource SecondsFromTicksConverter}}"
                            Value="{Binding PlayerVideo.Player.CurTime, Mode=TwoWay, Converter={StaticResource SecondsFromTicksConverter}}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="#fff"
                            HorizontalTextAlignment="Right"
                            Text="{Binding PlayerVideo.Player.Duration, Converter={StaticResource TicksToStringConverter}}" />
                    </Grid>

                    <Grid>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <coreUI:ABIconButton
                                BIcon="&#xE768;"
                                Command="{Binding PlayCommand}"
                                Icon="&#xE769;"
                                IsAOrB="{Binding PlayerVideo.Player.Status, ConverterParameter=Playing, Converter={StaticResource EnumComparisonToBoolConverter}}"
                                IsEnabled="{Binding PlayerVideo.Player.CanPlay}"
                                Variant="Text" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid
            Grid.Column="1"
            RowDefinitions="*,120,120"
            RowSpacing="5">
            <Grid
                Padding="10"
                Background="{ThemeResource WindowBackground}"
                BorderBrush="{ThemeResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                RowDefinitions="Auto,*"
                RowSpacing="5">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{coreHelpers:SRE K=VideoEdit}" />

                <StackPanel Grid.Row="1" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{coreHelpers:SRE K=Speed}" />

                        <Slider
                            Grid.Column="1"
                            Margin="20,0,10,0"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding VideoItem, Converter={StaticResource InvertedIsNullConverter}}"
                            Maximum="4"
                            Minimum="0.25"
                            SnapsTo="StepValues"
                            StepFrequency="0.05"
                            TickFrequency="0.5"
                            TickPlacement="Outside"
                            Value="{Binding VideoSpeedValue, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{coreHelpers:SRE K=Volume}" />

                        <Slider
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding VideoItem, Converter={StaticResource InvertedIsNullConverter}}"
                            Maximum="{Binding PlayerVideo.Player.Config.Player.VolumeMax}"
                            Minimum="0"
                            Value="{Binding PlayerVideo.Player.Audio.Volume, Mode=TwoWay}" />

                        <coreUI:IconButton
                            Grid.Column="2"
                            Command="{Binding MuteCommand}"
                            CommandParameter="Video"
                            Icon="{Binding PlayerVideo.VolumeIcon}"
                            IsEnabled="{Binding VideoItem, Converter={StaticResource InvertedIsNullConverter}}"
                            Variant="Text" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{coreHelpers:SRE K=Quality}" />

                        <coreUI:ComboBoxEx
                            Grid.Column="2"
                            Width="200"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Value"
                            IsEnabled="{Binding Status.IsNotProcessing}"
                            ItemsSource="{Binding VideoItem.ConvertArgv.Resolutions}"
                            SelectedIndex="{Binding VideoItem.ConvertArgv.ResolutionIndex, Mode=TwoWay}">
                            <coreUI:ComboBoxEx.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="coreHelpers:BindingHelper.IsEnabled" Value="IsEnabled" />
                                </Style>
                            </coreUI:ComboBoxEx.ItemContainerStyle>
                        </coreUI:ComboBoxEx>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{coreHelpers:SRE K=Format}" />

                        <coreUI:ComboBoxEx
                            Grid.Column="2"
                            Width="200"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Value"
                            IsEnabled="{Binding Status.IsNotProcessing}"
                            ItemsSource="{Binding VideoItem.ConvertArgv.Families}"
                            SelectedIndex="{Binding VideoItem.ConvertArgv.FamilyIndex, Mode=TwoWay}">
                            <coreUI:ComboBoxEx.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="coreHelpers:BindingHelper.IsEnabled" Value="IsEnabled" />
                                </Style>
                            </coreUI:ComboBoxEx.ItemContainerStyle>
                        </coreUI:ComboBoxEx>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{coreHelpers:SRE K=Rotate}" />

                                <coreUI:IconButton
                                    Command="{Binding ApplyTransformCommand}"
                                    CommandParameter="ClockwiseRotation"
                                    Icon="&#xE7AD;"
                                    IsEnabled="{Binding VideoItem, Converter={StaticResource InvertedIsNullConverter}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{coreHelpers:SRE K=Flip}" />

                                <StackPanel Orientation="Horizontal">
                                    <coreUI:IconButton
                                        Command="{Binding ApplyTransformCommand}"
                                        CommandParameter="HorizontalFlip"
                                        Icon="&#xF583;"
                                        IsEnabled="{Binding VideoItem, Converter={StaticResource InvertedIsNullConverter}}" />

                                    <coreUI:IconButton
                                        Command="{Binding ApplyTransformCommand}"
                                        CommandParameter="VerticalFlip"
                                        Icon="&#xF589;"
                                        IsEnabled="{Binding VideoItem, Converter={StaticResource InvertedIsNullConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <coreUI:IconButton
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Icon="&#xE713;"
                            IsEnabled="{Binding VideoItem, Converter={StaticResource InvertedIsNullConverter}}">

                            <coreUI:IconButton.Flyout>
                                <Flyout>
                                    <StackPanel Width="240" Spacing="10">
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{coreHelpers:SRE K=Video}" />
                                            <VariableSizedWrapGrid
                                                ItemWidth="120"
                                                MaximumRowsOrColumns="2"
                                                Orientation="Horizontal">
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{coreHelpers:SRE K=Media_FrameRate}" />
                                                    <coreUI:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{Binding VideoItem.ConvertArgv.FrameRates}"
                                                        SelectedIndex="{Binding VideoItem.ConvertArgv.FrameRateIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{coreHelpers:SRE K=Media_VideoCodec}" />
                                                    <coreUI:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{Binding VideoItem.ConvertArgv.VideoCodecs}"
                                                        SelectedIndex="{Binding VideoItem.ConvertArgv.VideoCodecIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{coreHelpers:SRE K=Media_VideoBitrate}" />
                                                    <coreUI:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{Binding VideoItem.ConvertArgv.VideoBitrates}"
                                                        SelectedIndex="{Binding VideoItem.ConvertArgv.VideoBitrateIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                            </VariableSizedWrapGrid>
                                        </StackPanel>
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{coreHelpers:SRE K=Audio}" />
                                            <VariableSizedWrapGrid
                                                ItemWidth="120"
                                                MaximumRowsOrColumns="2"
                                                Orientation="Horizontal">
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{coreHelpers:SRE K=Media_AudioCodec}" />
                                                    <coreUI:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{Binding VideoItem.ConvertArgv.AudioCodecs}"
                                                        SelectedIndex="{Binding VideoItem.ConvertArgv.AudioCodecIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{coreHelpers:SRE K=Media_AudioChannel}" />
                                                    <coreUI:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{Binding VideoItem.ConvertArgv.Channels}"
                                                        SelectedIndex="{Binding VideoItem.ConvertArgv.ChannelIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{coreHelpers:SRE K=Media_SampleRate}" />
                                                    <coreUI:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{Binding VideoItem.ConvertArgv.SampleRates}"
                                                        SelectedIndex="{Binding VideoItem.ConvertArgv.SampleRateIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Margin="2" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{coreHelpers:SRE K=Media_AudioBitrate}" />
                                                    <coreUI:ComboBoxEx
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{Binding VideoItem.ConvertArgv.AudioBitrates}"
                                                        SelectedIndex="{Binding VideoItem.ConvertArgv.AudioBitrateIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                            </VariableSizedWrapGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </coreUI:IconButton.Flyout>
                        </coreUI:IconButton>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                Padding="10"
                Background="{ThemeResource WindowBackground}"
                BorderBrush="{ThemeResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                RowDefinitions="Auto,*"
                RowSpacing="5">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{coreHelpers:SRE K=AudioEdit}" />

                <StackPanel Grid.Row="1" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{coreHelpers:SRE K=Speed}" />

                        <Slider
                            Grid.Column="1"
                            Margin="20,0,10,0"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding AudioItem, Converter={StaticResource InvertedIsNullConverter}}"
                            Maximum="4"
                            Minimum="0.25"
                            SnapsTo="StepValues"
                            StepFrequency="0.05"
                            TickFrequency="0.5"
                            TickPlacement="Outside"
                            Value="{Binding AudioSpeedValue, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{coreHelpers:SRE K=Volume}" />

                        <Slider
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding AudioItem, Converter={StaticResource InvertedIsNullConverter}}"
                            Maximum="{Binding PlayerAudio.Player.Config.Player.VolumeMax}"
                            Minimum="0"
                            Value="{Binding PlayerAudio.Player.Audio.Volume, Mode=TwoWay}" />

                        <coreUI:IconButton
                            Grid.Column="2"
                            Command="{Binding MuteCommand}"
                            CommandParameter="Audio"
                            Icon="{Binding PlayerAudio.VolumeIcon}"
                            IsEnabled="{Binding AudioItem, Converter={StaticResource InvertedIsNullConverter}}"
                            Variant="Text" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="2"
                Padding="10"
                Background="{ThemeResource WindowBackground}"
                BorderBrush="{ThemeResource Border}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel VerticalAlignment="Bottom" Spacing="10">
                    <StackPanel Spacing="5">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{coreHelpers:SRE K=Output}" />

                        <coreUI:TextBoxComp
                            HorizontalAlignment="Stretch"
                            PrefixIcon="&#xE838;"
                            Text="{Binding ConverterConfig.DefaultOutputPath}">
                            <coreUI:TextBoxComp.TextBoxStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="IsReadOnly" Value="True" />
                                </Style>
                            </coreUI:TextBoxComp.TextBoxStyle>
                            <coreUI:TextBoxComp.ActionButton>
                                <coreUI:IconButton Icon="&#xE8DA;" />
                            </coreUI:TextBoxComp.ActionButton>
                        </coreUI:TextBoxComp>
                    </StackPanel>

                    <Grid
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="10">
                        <coreUI:AZ
                            Grid.Column="1"
                            IsA="{Binding Status.IsProcessed}"
                            IsB="{Binding Status.IsProcessing}">
                            <coreUI:AZ.A>
                                <coreUI:IconButton
                                    Command="{Binding Window.RevealInFileExplorerCommand}"
                                    CommandParameter="{Binding OutputPath}"
                                    Icon="&#xE8E5;"
                                    Variant="Text" />
                            </coreUI:AZ.A>
                            <coreUI:AZ.B>
                                <Grid>
                                    <ProgressRing
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource ProgressRingForeground}"
                                        IsIndeterminate="False"
                                        Value="{Binding Percent}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding Percent}" />
                                </Grid>
                            </coreUI:AZ.B>
                        </coreUI:AZ>

                        <coreUI:ABIconTextButton
                            Grid.Column="2"
                            Width="120"
                            BText="{coreHelpers:SRE K=Cancel}"
                            Command="{Binding ExportCommand}"
                            IsAOrB="{Binding Status.IsNotProcessing}"
                            IsTheme="{Binding Status.IsNotProcessing}"
                            Text="{coreHelpers:SRE K=Export}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</pages:PlayerPage>